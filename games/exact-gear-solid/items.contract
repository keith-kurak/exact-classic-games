// Equipment and the radio. Q opens the item menu; the game pauses while it is
// open. Cigarettes: the first time you light up, your medical officer, Dr.
// Vale, calls to scold you, and afterward you smoke. The cardboard box: you
// hide inside it, and a guard notices only a box that moves while it watches.

shape Item
  id: number
  label: string
  name: string
  text: string

fn items(): Item[] = [
  Item(id=0, label="NO ITEM", name="No item", text="Hands free."),
  Item(id=1, label="CIGS", name="Cigarettes", text="A crumpled pack. Steadies the nerves. Your medical officer will not approve."),
  Item(id=2, label="C.BOX", name="Cardboard box", text="Get inside and keep still. Nobody looks twice at a box, unless it walks.")
]
fn itemAt(i: number): Item = match items().at(i) { case some(it) => it, case none => Item(id=0, label="NO ITEM", name="No item", text="") }

shape Line
  who: string
  text: string

fn freq(): string = "142.37"
fn callLines(): Line[] = [
  Line(who="VALE", text="Is that smoke I'm reading on your vitals? In the middle of an infiltration?"),
  Line(who="VALE", text="Do you know what you just breathed in? Carbon monoxide. It latches onto your hemoglobin more than two hundred times more tightly than oxygen does."),
  Line(who="VALE", text="So your blood carries less oxygen, right when your muscles need it most. You'll tire faster and get winded sooner."),
  Line(who="VALE", text="Then there's the nicotine. It squeezes your blood vessels and pushes your heart rate up. Shaky hands, a pounding pulse... not ideal when you're hiding."),
  Line(who="VALE", text="And the tar coats the cilia, the tiny hairs lining your airways, so your lungs can't sweep themselves clean. That's where a smoker's cough comes from."),
  Line(who="VALE", text="There are dozens of carcinogens in that smoke too. Some of them damage the DNA in your lung cells directly."),
  Line(who="YOU", text="Relax, Doc. It helps me think."),
  Line(who="VALE", text="Then think about this: one cough in that room and it's over. Put it out... please? For me?"),
  Line(who="YOU", text="...Noted.")
]
fn lineAt(i: number): Line = match callLines().at(i) { case some(l) => l, case none => Line(who="", text="") }

// An item's picture, 40 × 30.
component ItemIcon
  props
    id: number
  view
    svg viewBox="0 0 40 30" width=40 height=30
      if id == 1
        rect x=14 y=3 width=3 height=9 fill="#efe6d2"
        rect x=19 y=1 width=3 height=11 fill="#efe6d2"
        rect x=19 y=1 width=3 height=3 fill="#c98a4a"
        rect x=11 y=9 width=18 height=19 rx=1 fill="#d8d2c4"
        rect x=11 y=15 width=18 height=7 fill="#b2342b"
      if id == 2
        polygon points="6,10 20,4 34,10 20,16" fill="#c9a26b"
        polygon points="6,10 20,16 20,28 6,22" fill="#a07b48"
        polygon points="20,16 34,10 34,22 20,28" fill="#8a6a3c"
        line x1=13 y1=7 x2=27 y2=13 stroke="#e8d3a6" stroke-width=2
      if id == 0
        ellipse cx=20 cy=15 rx=9 ry=9 fill="none" stroke="#5f7d6b" stroke-width=2
        line x1=14 y1=21 x2=26 y2=9 stroke="#5f7d6b" stroke-width=2

// A radio portrait, monochrome green, 100 × 130: the medical officer (upset
// through the call, smiling from her last line), or you.
component Portrait
  props
    who: string
    lit: bool
    // Dr. Vale only: smiling (true) or upset.
    happy: bool
  view
    svg viewBox="0 0 100 130" width=150 height=195 opacity=(lit ? 1 : 0.5)
      rect x=0 y=0 width=100 height=130 fill="#06200f"
      if who == "VALE"
        // Long hair behind, a soft sweater and lab coat, a gentle face.
        ellipse cx=50 cy=74 rx=34 ry=48 fill="#1d5236"
        ellipse cx=50 cy=138 rx=44 ry=32 fill="#3e8f62"
        polygon points="30,112 44,104 50,128 26,130" fill="#bff5d6"
        polygon points="70,112 56,104 50,128 74,130" fill="#bff5d6"
        rect x=43 y=78 width=14 height=18 fill="#86d6aa"
        ellipse cx=50 cy=60 rx=20 ry=23 fill="#a6edc4"
        // Side-swept bangs and a hair clip.
        path d="M28,56 Q30,30 50,29 Q70,30 72,56 Q68,42 60,42 Q52,36 44,44 Q36,42 28,56 Z" fill="#1d5236"
        rect x=63 y=40 width=7 height=2.6 rx=1.2 fill="#d8ffe9"
        if happy
          // Pleased: soft brows, wide bright eyes, lashes, a smile.
          path d="M36,53 Q41,50.5 46,53" fill="none" stroke="#1d5236" stroke-width=1.4
          path d="M54,53 Q59,50.5 64,53" fill="none" stroke="#1d5236" stroke-width=1.4
          ellipse cx=41.5 cy=61 rx=4.4 ry=5.4 fill="#0d2e1d"
          ellipse cx=58.5 cy=61 rx=4.4 ry=5.4 fill="#0d2e1d"
          ellipse cx=43 cy=59 rx=1.5 ry=1.6 fill="#effff6"
          ellipse cx=60 cy=59 rx=1.5 ry=1.6 fill="#effff6"
          line x1=37 y1=57.5 x2=35.5 y2=56 stroke="#0d2e1d" stroke-width=1.1
          line x1=63 y1=57.5 x2=64.5 y2=56 stroke="#0d2e1d" stroke-width=1.1
          path d="M44.5,74 Q50,78.5 55.5,74" fill="none" stroke="#2c6b48" stroke-width=1.6
        else
          // Upset: brows drawn down toward the middle, big eyes narrowed under
          // flat lids, a pouting frown, and a cross-shaped "angry" mark.
          path d="M35.5,52 Q41,52.5 46.5,56.5" fill="none" stroke="#1d5236" stroke-width=1.8
          path d="M64.5,52 Q59,52.5 53.5,56.5" fill="none" stroke="#1d5236" stroke-width=1.8
          ellipse cx=41.5 cy=62 rx=4.4 ry=4.6 fill="#0d2e1d"
          ellipse cx=58.5 cy=62 rx=4.4 ry=4.6 fill="#0d2e1d"
          rect x=36.5 y=56 width=10 height=3.6 fill="#a6edc4"
          rect x=53.5 y=56 width=10 height=3.6 fill="#a6edc4"
          line x1=36.8 y1=59.6 x2=46.2 y2=59.6 stroke="#0d2e1d" stroke-width=1.3
          line x1=53.8 y1=59.6 x2=63.2 y2=59.6 stroke="#0d2e1d" stroke-width=1.3
          ellipse cx=43 cy=61 rx=1.4 ry=1.4 fill="#effff6"
          ellipse cx=60 cy=61 rx=1.4 ry=1.4 fill="#effff6"
          line x1=37 y1=59.6 x2=35.2 y2=58.4 stroke="#0d2e1d" stroke-width=1.1
          line x1=63 y1=59.6 x2=64.8 y2=58.4 stroke="#0d2e1d" stroke-width=1.1
          path d="M66,45 Q68,47 70,45" fill="none" stroke="#e8fff2" stroke-width=1.3
          path d="M66,50 Q68,48 70,50" fill="none" stroke="#e8fff2" stroke-width=1.3
          path d="M65.5,45.5 Q67.5,47.5 65.5,49.5" fill="none" stroke="#e8fff2" stroke-width=1.3
          path d="M70.5,45.5 Q68.5,47.5 70.5,49.5" fill="none" stroke="#e8fff2" stroke-width=1.3
          path d="M45,77 Q50,73 55,77" fill="none" stroke="#2c6b48" stroke-width=1.7
        // Flushed cheeks and a small nose.
        ellipse cx=36.5 cy=69 rx=4.8 ry=2.4 fill="#d4ffe6" opacity=0.7
        ellipse cx=63.5 cy=69 rx=4.8 ry=2.4 fill="#d4ffe6" opacity=0.7
        path d="M49.5,66 Q50.5,68.5 49,69" fill="none" stroke="#4f9a72" stroke-width=1
      if who == "YOU"
        // Broad shoulders, a tactical collar and hood, goggles pushed up.
        ellipse cx=50 cy=140 rx=50 ry=36 fill="#1f5236"
        polygon points="26,108 40,96 50,104 60,96 74,108 62,116 38,116" fill="#163d28"
        ellipse cx=50 cy=56 rx=31 ry=36 fill="#123222"
        polygon points="33,50 67,50 69,70 60,88 40,88 31,70" fill="#6cb98f"
        rect x=31 y=38 width=38 height=10 rx=3 fill="#b6ffd8"
        rect x=33 y=40 width=34 height=2.5 fill="#e8fff2" opacity=0.7
        // Heavy brows driven down, narrowed eyes, a hard mouth.
        polygon points="34,56 47,60 47,63 34,59" fill="#0d2e1d"
        polygon points="66,56 53,60 53,63 66,59" fill="#0d2e1d"
        polygon points="37,64 46,65.5 45,67.5 38,66.5" fill="#0d2e1d"
        polygon points="63,64 54,65.5 55,67.5 62,66.5" fill="#0d2e1d"
        ellipse cx=42.5 cy=66 rx=1 ry=0.8 fill="#e8fff2"
        ellipse cx=57.5 cy=66 rx=1 ry=0.8 fill="#e8fff2"
        line x1=50 y1=63 x2=49 y2=74 stroke="#3d8a62" stroke-width=1.4
        line x1=46.5 y1=75 x2=52 y2=75 stroke="#3d8a62" stroke-width=1.2
        line x1=43 y1=81 x2=57 y2=80 stroke="#0d2e1d" stroke-width=2
        line x1=43 y1=81 x2=41 y2=83 stroke="#0d2e1d" stroke-width=1.4
        // Stubble, cheekbones and a scar through the brow.
        polygon points="36,77 64,77 59,88 41,88" fill="#3f8a60" opacity=0.55
        line x1=33 y1=70 x2=40 y2=73 stroke="#3d8a62" stroke-width=1.2
        line x1=67 y1=70 x2=60 y2=73 stroke="#3d8a62" stroke-width=1.2
        line x1=58 y1=53 x2=63 y2=71 stroke="#c8ffe0" stroke-width=1.2
      for y in [6, 16, 26, 36, 46, 56, 66, 76, 86, 96, 106, 116, 126] key=`s${y}`
        rect x=0 y=y width=100 height=1.2 fill="#000000" opacity=0.25
