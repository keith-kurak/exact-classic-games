// Exact Gear Solid: one room of a late-90s stealth game. Cross the storage room
// to the exit without being seen. Four guards patrol the aisles between three
// rows of containers. The camera looks down from above; push against a wall to
// press your back to it, and the camera drops beside you to look along it. The
// radar shows every guard and its view cone. If a guard clearly sees you
// (about 0.3 s in its cone), you are caught.
use Spot, Guard, roomW, roomD, radius, sq, mag, sgn, nth, solid, atExit, guard, advI, advT, advW, sees, cone, blockSpots from "./room.contract"

fn dirX(k: string): number = (k == "ArrowLeft" or k == "a" ? -1 : (k == "ArrowRight" or k == "d" ? 1 : 0))
fn dirY(k: string): number = (k == "ArrowUp" or k == "w" ? -1 : (k == "ArrowDown" or k == "s" ? 1 : 0))
fn isMove(k: string): bool = dirX(k) != 0 or dirY(k) != 0
fn isGo(k: string): bool = k == " " or k == "Enter"
fn clock(ticks: number): string = `${floor(ticks * 33 / 60000)}:${floor(ticks * 33 / 1000) % 60 < 10 ? "0" : ""}${floor(ticks * 33 / 1000) % 60}`
fn step(): number = 0.085
fn spotLimit(): number = 9

component ExactGearSolid
  state px = 1.5
  state py = 18.5
  state fx = 0
  state fy = -1
  // The direction keys held.
  state hx = 0
  state hy = 0
  state moving = false
  // Against a wall: n is the wall's normal (away from it), l the way the
  // camera looks along it.
  state pressed = false
  state push = 0
  state nx = 0
  state ny = 0
  state lx = 1
  state ly = 0
  // The guards: leg, distance along it, and pause left.
  state si: number[] = [0, 0, 1, 2]
  state st: number[] = [5, 10, 2, 1]
  state sw: number[] = [0, 0, 0, 0]
  state spot = 0
  state seenBy = -1
  // play → caught (→ over) or clear.
  state phase = "play"
  state over = false
  state ticks = 0

  derive g0 = guard(0, nth(si, 0), nth(st, 0), nth(sw, 0))
  derive g1 = guard(1, nth(si, 1), nth(st, 1), nth(sw, 1))
  derive g2 = guard(2, nth(si, 2), nth(st, 2), nth(sw, 2))
  derive g3 = guard(3, nth(si, 3), nth(st, 3), nth(sw, 3))
  derive guards = [g0, g1, g2, g3]
  // The camera: high above the player, or low beside them along the wall.
  derive camX = pressed ? px + nx * 0.95 - lx * 2.1 : px
  derive camY = pressed ? 1.5 : 10
  derive camZ = pressed ? py + ny * 0.95 - ly * 2.1 : min(py + 5, roomD() + 1.5)
  derive lookX = pressed ? px + lx * 5 + nx * 0.7 : px
  derive lookY = pressed ? 1.1 : 0
  derive lookZ = pressed ? py + ly * 5 + ny * 0.7 : py - 0.6
  derive alert = phase == "caught" ? 1 : spot / spotLimit() * 0.5

  // ── One frame: the guards walk, the player moves, the guards look ──

  task frame when phase == "play"
    every(33, tick)

  action tick
    // Every update reads last frame's guards and player.
    let ks = [0, 1, 2, 3]
    let i0 = si
    let t0 = st
    let w0 = sw
    let ox = px
    let oy = py
    si = ks.map(k => advI(k, nth(i0, k), nth(t0, k), nth(w0, k)))
    st = ks.map(k => advT(k, nth(i0, k), nth(t0, k), nth(w0, k)))
    sw = ks.map(k => advW(k, nth(i0, k), nth(t0, k), nth(w0, k)))
    ticks = ticks + 1
    if pressed
      slide()
    else
      walk()
    let who = ks.filter(k => (k == 0 and sees(g0, ox, oy)) or (k == 1 and sees(g1, ox, oy))
      or (k == 2 and sees(g2, ox, oy)) or (k == 3 and sees(g3, ox, oy)))
    let next = who.length > 0 ? spot + 1 : max(0, spot - 1)
    spot = next
    if next >= spotLimit()
      seenBy = nth(who, 0)
      phase = "caught"
    if atExit(ox, oy)
      phase = "clear"

  action walk
    let diag = hx != 0 and hy != 0 ? 0.707 : 1
    let tx = px + hx * step() * diag
    let okx = not solid(tx, py, radius())
    let nxp = okx ? tx : px
    let ty = py + hy * step() * diag
    let oky = not solid(nxp, ty, radius())
    let nyp = oky ? ty : py
    px = nxp
    py = nyp
    moving = hx != 0 or hy != 0
    if hx != 0 or hy != 0
      fx = hx * diag
      fy = hy * diag
    // Pushing straight into a wall for a quarter second presses your back to it.
    let into = (hx != 0 and hy == 0 and not okx) or (hy != 0 and hx == 0 and not oky)
    let p = into ? push + 1 : 0
    push = p
    if p >= 8
      pressed = true
      nx = 0 - hx
      ny = 0 - hy
      lx = hy != 0 ? 1 : 0
      ly = hx != 0 ? -1 : 0
      fx = 0 - hx
      fy = 0 - hy
      moving = false

  // Along the wall, the player slides; at its end they stop at the corner and
  // can look round it. Moving away from the wall steps off it.
  action slide
    let away = hx * nx + hy * ny > 0
    let along = hx * ny - hy * nx
    if away
      pressed = false
      push = 0
    else
      if along != 0
        let dx = along * ny
        let dy = 0 - along * nx
        let tx = px + dx * step() * 0.7
        let ty = py + dy * step() * 0.7
        let backed = solid(tx - nx * 0.45, ty - ny * 0.45, 0)
        let free = not solid(tx, ty, radius())
        lx = dx
        ly = dy
        moving = backed and free
        if backed and free
          px = tx
          py = ty
      else
        moving = false

  task caughtPause when phase == "caught"
    after(900, showOver)
  action showOver
    over = true

  action restart
    px = 1.5
    py = 18.5
    fx = 0
    fy = -1
    hx = 0
    hy = 0
    moving = false
    pressed = false
    push = 0
    si = [0, 0, 1, 2]
    st = [5, 10, 2, 1]
    sw = [0, 0, 0, 0]
    spot = 0
    seenBy = -1
    over = false
    ticks = 0
    phase = "play"

  // ── Keys ──

  action onKey(k: string, e: KeyboardEvent)
    if isMove(k) or isGo(k)
      preventDefault()
    if phase == "play"
      if dirX(k) != 0
        hx = dirX(k)
      if dirY(k) != 0
        hy = dirY(k)
    else
      if isGo(k) and (over or phase == "clear")
        restart()

  action onKeyUp(k: string)
    if dirX(k) != 0 and dirX(k) == hx
      hx = 0
    if dirY(k) != 0 and dirY(k) == hy
      hy = 0

  view
    main testId="root" key=onKey keyup=onKeyUp width="100%" height="100%" color-scheme="dark"
      background-color="#000000" position="relative" overflow="hidden"
      canvas surface=room((pressed ? 1 : 0), camX, camY, camZ, alert, lookX, lookY, lookZ, (moving ? 1 : 0),
        px, py, fx, fy, g0.x, g0.y, g0.fx, g0.fy, g1.x, g1.y, g1.fx, g1.fy,
        g2.x, g2.y, g2.fx, g2.fy, g3.x, g3.y, g3.fx, g3.fy)
        position="absolute" left=0 top=0 width="100%" height="100%" testId="room"
      // The radar: the room from above, the guards' view cones, and you.
      column position="absolute" top=16 right=16 padding=4 background-color="#020a06e6"
        border="2px solid #3fdc7a" testId="radar"
        svg viewBox="-0.5 -0.5 28 21" width=224 height=168
          rect x=0 y=0 width=roomW() height=roomD() fill="#06170d" stroke="#3fdc7a" stroke-width=0.25
          for b in blockSpots() key=`${b.x}-${b.y}`
            rect x=b.x y=b.y width=4 height=3.5 fill="none" stroke="#3fdc7a" stroke-width=0.25
          rect x=22.5 y=-0.3 width=3 height=0.6 fill="#3fdc7a"
          for g in guards key=`${g.fx}-${g.fy}-${g.x}`
            polygon points=cone(g) fill="#4fd3ff" opacity=0.28
            ellipse cx=g.x cy=g.y rx=0.55 ry=0.55 fill="#ff3b30"
          ellipse cx=px cy=py rx=0.55 ry=0.55 fill="#ffffff" testId="radar-you"
      // Status, bottom left.
      column position="absolute" left=16 bottom=16 gap=4 padding="8px 12px" background-color="#000000b0"
        border-left="3px solid #3fdc7a"
        text "STORAGE ROOM B" font-size=13 font-weight=900 letter-spacing=3 color="#3fdc7a"
        text clock(ticks) font-size=20 font-weight=800 font-variant-numeric="tabular-nums" color="#e8f5ec" testId="clock"
        text (pressed ? "Against the wall · slide along it, step away to leave" : "Reach the exit, top right · press into a wall to hug it")
          font-size=12 color="#a9c4b2" testId="hint"
      if spot > 0 and phase == "play"
        text "?" position="absolute" top="30%" left=0 right=0 text-align="center" font-size=72 font-weight=900
          color="#ffd23f" testId="suspicious"
      if phase == "caught" and not over
        text "!" position="absolute" top="26%" left=0 right=0 text-align="center" font-size=120 font-weight=900
          color="#ff3b30" testId="spotted"
      if over
        column position="absolute" inset=0 align-items="center" justify-content="center" gap=10
          background-color="#000000c8" testId="game-over"
          text "SPOTTED" font-size=52 font-weight=900 letter-spacing=8 color="#ff3b30"
          text "A guard saw you." font-size=16 color="#e8f5ec"
          text "Space to try again" font-size=14 color="#a9c4b2"
      if phase == "clear"
        column position="absolute" inset=0 align-items="center" justify-content="center" gap=10
          background-color="#000000c8" testId="cleared"
          text "ROOM CLEARED" font-size=48 font-weight=900 letter-spacing=6 color="#3fdc7a"
          text `Time ${clock(ticks)}` font-size=18 font-weight=700 color="#e8f5ec"
          text "Space to play again" font-size=14 color="#a9c4b2"
