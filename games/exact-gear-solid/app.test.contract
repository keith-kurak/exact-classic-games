test "the room starts with the player at the south-west corner and the radar up"
  expect tree has "room"
  expect tree has "radar"
  expect tree has "radar-you"
  expect state phase == "play"
  expect state pressed == false
  expect text "clock" == "0:00"

test "holding up walks north, and letting go stops"
  type "root" key "ArrowUp" down
  clock +1000
  type "root" key "ArrowUp" up
  clock +100
  expect state moving == false
  expect state hy == 0

test "pushing into a wall presses your back to it, and stepping away leaves it"
  type "root" key "ArrowDown" down
  clock +1000
  expect state pressed == true
  expect text "hint" == "Against the wall · slide along it, step away to leave"
  type "root" key "ArrowDown" up
  type "root" key "ArrowRight" down
  clock +500
  type "root" key "ArrowRight" up
  expect state pressed == true
  type "root" key "ArrowUp" down
  clock +100
  type "root" key "ArrowUp" up
  expect state pressed == false

test "standing in a guard's aisle gets you caught"
  type "root" key "ArrowUp" down
  clock +4200
  type "root" key "ArrowUp" up
  clock +40000
  expect state phase == "caught"
  expect tree has "game-over"
  type "root" key " "
  expect state phase == "play"
  expect state px == 1.5

test "sliding past the end of a container leans round its corner"
  type "root" key "ArrowUp" down
  clock +1000
  type "root" key "ArrowUp" up
  type "root" key "ArrowRight" down
  clock +1200
  type "root" key "ArrowRight" up
  expect state pressed == true
  clock +600
  expect state ct == 1
  type "root" key "ArrowUp" down
  clock +2000
  expect state peek == true
  expect text "hint" == "Round the corner · let go to lean back"
  clock +600
  expect state pk == 1
  type "root" key "ArrowUp" up
  clock +600
  expect state peek == false
  expect state pk == 0

test "a guard at a waypoint looks left, holds, sweeps right, holds, then turns"
  clock +14600
  expect state g0.fx == 1
  clock +900
  expect state g0.fy == -1
  clock +1300
  expect state g0.fy == 1
  clock +1300
  expect state g0.fx == -1

test "Q opens the items, which pause the game, and Escape closes them"
  type "root" key "q"
  expect tree has "items"
  expect text "item-name" == "‹No item›"
  type "root" key "ArrowRight"
  expect text "item-name" == "‹Cigarettes›"
  type "root" key "ArrowLeft"
  type "root" key "ArrowLeft"
  expect text "item-name" == "‹Cardboard box›"
  clock +1000
  expect text "clock" == "0:00"
  type "root" key "Escape"
  expect tree missing "items"
  expect state item == 0

test "lighting up brings a call from the medical officer, then you smoke"
  type "root" key "q"
  type "root" key "ArrowRight"
  type "root" key "q"
  expect state item == 1
  expect tree has "equipped"
  expect tree has "ringing"
  clock +1300
  expect tree has "call"
  expect text "freq" == "142.37"
  expect text "speaker" == "DR. VALE"
  clock +3000
  expect text "call-line" == "Is that smoke I'm reading on your vitals? In the middle of an infiltration?"
  expect state smiling == false
  type "root" key " "
  type "root" key " "
  type "root" key " "
  type "root" key " "
  type "root" key " "
  type "root" key " "
  type "root" key " "
  type "root" key " "
  type "root" key " "
  type "root" key " "
  type "root" key " "
  type "root" key " "
  type "root" key " "
  type "root" key " "
  type "root" key " "
  type "root" key " "
  type "root" key " "
  type "root" key " "
  type "root" key " "
  type "root" key " "
  expect tree missing "call"
  expect state item == 1
  type "root" key "q"
  type "root" key "ArrowLeft"
  type "root" key "q"
  expect state item == 0
  type "root" key "q"
  type "root" key "ArrowRight"
  type "root" key "q"
  expect state item == 1
  clock +1500
  expect tree missing "call"
  expect tree missing "ringing"

test "keeping still in the box, a passing guard does not see you"
  type "root" key "ArrowUp" down
  clock +4200
  type "root" key "ArrowUp" up
  type "root" key "q"
  type "root" key "ArrowLeft"
  type "root" key "q"
  expect state item == 2
  expect text "hint" == "In the box · keep still and nobody looks twice"
  clock +40000
  expect state phase == "play"
  expect state spot == 0

test "leaning round a corner, a guard far down the cross aisle does not see you"
  type "root" key "ArrowUp" down
  clock +1000
  type "root" key "ArrowUp" up
  type "root" key "ArrowRight" down
  clock +1200
  type "root" key "ArrowRight" up
  type "root" key "ArrowUp" down
  clock +2000
  expect state peek == true
  clock +12000
  expect state phase == "play"
