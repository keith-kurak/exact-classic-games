// Battle rules. Each member's ATB gauge has two segments; each ability fills
// one, and a full gauge acts them out in turn. When Rook's gauge is full, the
// game waits for you: Auto (fill both by his role, then confirm), his role's
// two abilities one segment at a time, or Item; Left opens the stance menu
// (switch everyone's roles, free). Ivy and Kai fill theirs by role and act.
//
// Roles: Strike attacks (the only role that can); Blast casts Fire and Ice,
// which build an enemy's chain fast; Mend casts Cure and Heal; Guard provokes
// and steels itself. A chain drains quickly, unless a Strike hit has just
// steadied it. Fill the stagger bar and the enemy is staggered: it takes
// far more damage until the bar drains.

shape Foe
  name: string
  hp: number
  atk: number
  breakAt: number
  speed: number
  // The time to beat for a five-star rank, in battle ticks (50 ms).
  par: number

fn drone(): Foe = Foe(name="Drone", hp=140, atk=12, breakAt=180, speed=0.36, par=500)
fn hound(): Foe = Foe(name="Hound", hp=100, atk=16, breakAt=150, speed=0.46, par=380)
fn foeOf(name: string): Foe = (name == "Drone" ? drone() : hound())
// Enemy groups, and where each enemy stands, in tiles (even, for attributes).
fn group(k: number): string[] = (k == 0 ? ["Drone"] : (k == 1 ? ["Hound", "Hound"] : ["Drone", "Hound"]))
// Enemies are 64×64 (8×8 tiles); two stand side by side, one stands centred.
fn foeTx(i: number, count: number): number = (count == 1 ? 6 : (i == 0 ? 2 : 12))
fn foeTy(i: number): number = 8
fn labelRow(): number = 16
// The label under an enemy: its stagger bar (5 tiles) and chain. Staggered,
// the bar shows the stagger draining and the chain turns yellow.
fn staggerText(chain: number, brk: number, breakAt: number): string = (brk > 0
  ? `${gauge(brk / staggerTicks() * 40, 5)} {${floor(chain)}%}`
  : `${gauge((chain - 100) / (breakAt - 100) * 40, 5)} ${floor(chain)}%`)
fn parOf(g: string[]): number = foeOf(word(g, 0)).par + (g.length > 1 ? foeOf(word(g, 1)).par : 0)

fn names(): string[] = ["Rook", "Ivy", "Kai"]
fn nameOf(i: number): string = match names().at(i) { case some(n) => n, case none => "" }
fn maxHp(i: number): number = (i == 0 ? 120 : (i == 1 ? 100 : 90))
fn atkOf(i: number): number = (i == 0 ? 14 : (i == 1 ? 10 : 12))
fn speedOf(i: number): number = (i == 0 ? 0.5 : (i == 1 ? 0.42 : 0.46))
fn full(): number = 24

// Stances: the role each member plays in each.
fn stances(): number = 4
fn stanceName(s: number): string = (s == 0 ? "Assault" : (s == 1 ? "Rush" : (s == 2 ? "Balance" : "Bulwark")))
fn roleOf(s: number, i: number): string = (s == 0 ? "Blast"
  : (s == 1 ? (i == 2 ? "Blast" : "Strike")
  : (s == 2 ? (i == 0 ? "Strike" : (i == 1 ? "Mend" : "Blast"))
  : (i == 0 ? "Guard" : "Mend"))))

// Each role's two abilities.
fn abilityOf(role: string, k: number): string = (role == "Strike" ? (k == 0 ? "Attack" : "Slash")
  : (role == "Blast" ? (k == 0 ? "Fire" : "Ice")
  : (role == "Mend" ? (k == 0 ? "Cure" : "Heal") : (k == 0 ? "Provoke" : "Steel"))))
fn needsTarget(cmd: string): bool = cmd == "Attack" or cmd == "Slash" or cmd == "Fire" or cmd == "Ice"
fn isStrike(cmd: string): bool = cmd == "Attack" or cmd == "Slash"
// Damage before the chain, and how much it adds to the chain.
fn power(cmd: string, atk: number): number = (cmd == "Slash" ? atk * 2 : (cmd == "Attack" ? atk * 1.4 : (cmd == "Fire" ? atk * 1.2 : atk * 0.9)))
fn chainGain(cmd: string): number = (cmd == "Fire" ? 24 : (cmd == "Ice" ? 18 : (cmd == "Slash" ? 6 : 4)))
fn hitFor(base: number, chain: number, broken: bool, r: number): number =
  round(base * chain / 100 * (broken ? 1.5 : 1) * (0.9 + (r % 21) / 100))
// How fast a chain drains a tick: slowly while a Strike hit steadies it.
fn drain(held: bool): number = (held ? 0.1 : 0.45)
fn staggerTicks(): number = 120

// The living member with the smallest share of their HP left.
fn ratio(hp: number[], i: number): number = (nth(hp, i) <= 0 ? 99999 : nth(hp, i) * 1000 / maxHp(i))
fn lowest(hp: number[]): number = (ratio(hp, 0) <= ratio(hp, 1) and ratio(hp, 0) <= ratio(hp, 2) ? 0 : (ratio(hp, 1) <= ratio(hp, 2) ? 1 : 2))

// Each turn fills two ATB segments, one ability each.
fn segments(): number = 2
// What fills both segments when chosen by role (allies always; Rook's Auto).
// Strike attacks then slashes; Blast casts Fire then Ice; Mend cures twice
// when someone is badly hurt, else heals everyone; Guard provokes, then
// steels itself (only steels, if it is already provoking).
fn rolePlan(role: string, hurt: bool, provoking: bool): string[] =
  (role == "Strike" ? ["Attack", "Slash"] : (role == "Blast" ? ["Fire", "Ice"]
    : (role == "Mend" ? (hurt ? ["Cure", "Cure"] : ["Heal", "Heal"]) : (provoking ? ["Steel", "Steel"] : ["Provoke", "Steel"]))))
// The top window names abilities; a plain attack shows nothing.
fn announce(name: string): string = (name == "Attack" or name == "attack" ? "" : name)

// Potions: the party leader's item. Each heals everyone still standing.
fn potionHeal(): number = 50
fn startPotions(): number = 3

// The rank for a win: five stars at or under par, one fewer each quarter over.
fn stars(ticks: number, par: number): number = max(1, min(5, 5 - floor(max(0, ticks - par) * 4 / par)))
fn starLine(n: number): string = `{${"*****".slice(0, n)}}${"^^^^^".slice(0, 5 - n)}`
fn clockOf(ticks: number): string = `${floor(ticks / 1200)}:${floor(ticks / 20) % 60 < 10 ? "0" : ""}${floor(ticks / 20) % 60}`

// ── Small helpers ──
fn nth(xs: number[], k: number): number = match xs.at(k) { case some(v) => v, case none => 0 }
fn word(xs: string[], k: number): string = match xs.at(k) { case some(v) => v, case none => "" }
fn put(xs: number[], k: number, v: number): number[] = [0, 1, 2].filter(i => i < xs.length).map(i => (i == k ? v : nth(xs, i)))
fn pad3(n: number): string = (n < 10 ? `  ${n}` : (n < 100 ? ` ${n}` : `${n}`))
fn padTo(s: string, n: number): string = `${s}${"            ".slice(0, max(0, n - s.length))}`
// A gauge as bar tiles: `~0`–`~8` a tile, that many pixels filled.
fn barTile(v: number): string = `~${max(0, min(8, floor(v)))}`
fn gauge(v: number, tiles: number): string = [0, 1, 2, 3].filter(i => i < tiles).map(i => barTile(v - i * 8)).join("")
