// Exact Odyssey: an RPG drawn by an NES-style picture processor (the `ppu`
// surface in gpu/, on the nes-ppu engine in engines/). This file is the game:
// it walks the field, starts fights, runs the battle, and tells the surface
// what is on screen as small text specs (see gpu/src/lib.rs).
use Npc, fieldMap, tileAt, walkable, thicket, npcs, npcAt, blocked, dx, dy, camAxis, nextRng from "./field.contract"
use Foe, foeOf, group, foeTx, foeTy, labelRow, juggleTicks, panelName, panelBar, potionHeal, startPotions, parOf, nameOf, maxHp, atkOf, speedOf, full, stances, stanceName, roleOf, abilityOf, needsTarget, isStrike, power, chainGain, hitFor, chainUp, maxChain, drain, staggerTicks, rolePlan, segments, segment, announce, slotText, lowest, stars, starLine, clockOf, nth, word, put, pad3, padTo, gauge from "./battle.contract"

fn keyDir(k: string): string = (k == "ArrowUp" or k == "w" ? "up" : (k == "ArrowDown" or k == "s" ? "down"
  : (k == "ArrowLeft" or k == "a" ? "left" : (k == "ArrowRight" or k == "d" ? "right" : ""))))
fn confirmKey(k: string): bool = k == " " or k == "Enter" or k == "z"
fn cancelKey(k: string): bool = k == "Escape" or k == "x"
fn startX(): number = 11
fn startY(): number = 7
fn partyX(i: number): number = (i == 1 ? 208 : 200)
fn partyY(i: number): number = 48 + i * 28

component ExactOdyssey
  // ── The field ──
  state tx = 11
  state ty = 7
  state dir = "down"
  state off = 0
  state moving = false
  state steps = 0
  state held = ""
  state talkTo = -1
  state rng = 7
  state sinceFight = 0
  // ── Scenes and fades ──
  state scene = "field"
  state fade = 0
  state fading = ""
  state next = ""
  // ── The battle ──
  // Everything runs in real time: gauges fill and enemies act while Thunda's
  // menu is open. Only one action plays at a time; the next follows at once.
  state foes: string[] = []
  state foeHp: number[] = []
  state chain: number[] = []
  state brk: number[] = []
  state foeAtb: number[] = []
  state fx: number[] = []
  state hp: number[] = [120, 100, 90]
  state atb: number[] = [0, 0, 0]
  state stance = 0
  // The fight: "intro", "fight", "won" or "lost".
  state phase = ""
  // Thunda's input: "menu", "target", "stance" or "item".
  state ui = "menu"
  state cursor = 0
  state stanceCursor = 0
  // Thunda's two ATB slots, their targets, and whether they are committed.
  state plan: string[] = []
  state planAims: number[] = []
  state committed = false
  // Go now: run the committed commands whose segments have filled.
  state rush = false
  // The last enemy Thunda aimed at: the allies follow her lead.
  state focus = 0
  state target = 0
  // What is playing: "" (nothing), "act" (a member) or "foeAct"; who; the
  // abilities, their targets, which is next, and wind-up (0) or follow-through (1).
  state play = ""
  state actor = 0
  state queue: string[] = []
  state qAims: number[] = []
  state qi = 0
  state step = 0
  state lastAuto = ""
  state staggers = 0
  state msg = ""
  state dmgText = ""
  state dmgX = 0
  state dmgY = 0
  state dmgT = 0
  state provoke = -1
  state steel = -1
  state wins = 0
  // Ticks each enemy's chain stays steadied by a Strike hit.
  state hold: number[] = []
  // Ticks each enemy stays juggled (launched, upside down), and how often.
  state juggle: number[] = []
  state juggles = 0
  state rookTurns = 0
  // Ticks since the one acting began: they leap to the enemy over 5.
  state leap = 0
  // The fight's length and par in ticks, and its rank in stars.
  state bticks = 0
  state par = 0
  state rank = 0
  // The party leader's potions, kept between fights.
  state potions = 3
  state found = false

  // ── What is on screen ──
  derive px = tx * 16 + dx(dir) * off
  derive py = ty * 16 + dy(dir) * off
  derive camX = camAxis(px, 120, 512, 256)
  derive camY = camAxis(py, 112, 320, 240)
  // Feet always move, walking or standing: the surface steps any name
  // ending `*` in place from its frame counter.
  derive heroName = `${dir == "right" ? "left" : dir}*`
  derive talking = talkTo >= 0
  derive talkLines = match npcs().at(talkTo) { case some(n) => n.lines, case none => [] }
  // While a window is open, sprites low on the screen would cover it.
  derive fieldSprites = ((not talking or py - camY < 136 ? [`${heroName}:${px - camX}:${py - camY}:${dir == "right" ? "h" : ""}`] : [])
    .concat(npcs().filter(n => not talking or n.y * 16 - camY < 136).map(n => `villager*:${n.x * 16 - camX}:${n.y * 16 - camY}:`)))
  derive fieldWindows = talking ? `1,19,30,10,2|${talkLines.join("|")}` : ""

  derive inBattle = scene == "battle"
  derive fighting = phase == "fight"
  derive acting = play == "act"
  // Strike moves leap in an arc to beside the target; spells are thrown from
  // where the caster stands: a fire or ice ball flies to the target.
  derive aimNow = nth(foeHp, nth(qAims, qi)) > 0 ? nth(qAims, qi) : (nth(qAims, qi) == 0 ? 1 : 0)
  derive leaping = acting and isStrike(word(queue, qi))
  derive spell = acting and (word(queue, qi) == "Fire" or word(queue, qi) == "Ice")
  derive throwT = min(1, leap / 4)
  derive ballX = round(partyX(actor) - 18 + (foeTx(aimNow, foes.length) * 8 + 24 - (partyX(actor) - 18)) * throwT)
  derive ballY = round(partyY(actor) + 4 + (foeTy(aimNow) * 8 + 22 - (partyY(actor) + 4)) * throwT - sin(throwT * 3.14159) * 10)
  derive ballSprite = spell and step == 0 ? [`${word(queue, qi) == "Fire" ? "fireball" : "iceball"}:${ballX}:${ballY}:`] : []
  derive leapT = min(1, leap / 5)
  derive leapX = round(partyX(actor) + (foeTx(aimNow, foes.length) * 8 + 66 - partyX(actor)) * leapT)
  derive leapY = round(partyY(actor) + (foeTy(aimNow) * 8 + 24 - partyY(actor)) * leapT - sin(leapT * 3.14159) * 14)
  derive partySprites = [0, 1, 2].map(i => `${nth(hp, i) <= 0 ? "ko" : (acting and actor == i ? (leaping ? `strike${i}` : `cast${i}`) : `idle${i}`)}:${acting and actor == i ? (leaping ? leapX : partyX(i) - 8) : partyX(i)}:${acting and actor == i and leaping ? leapY : partyY(i)}:${i}`)
  derive pointing = fighting and not committed
  // The chooser, bottom left: commands, or a target, stance or item list in
  // their place. It goes away while Thunda's commands wait or play out.
  derive chooserShown = fighting and not rookActing and not (committed and ui == "menu")
  derive handRow = (ui == "target" ? target + 1 : (ui == "stance" ? stanceCursor : (ui == "item" ? 0 : cursor)))
  derive handSprite = chooserShown ? [`hand:2:${(21 + handRow * 2) * 8}:`] : []
  derive dmgSprite = dmgT > 0 ? [`#${dmgText}:${dmgX}:${dmgY - (dmgT > 12 ? (16 - dmgT) * 2 : 8)}:3`] : []
  // OAM order is draw priority: damage numbers and the cursor in front.
  derive battleSprites = dmgSprite.concat(handSprite).concat(ballSprite).concat(partySprites)
  derive enemySpec = ([0, 1].filter(i => i < foes.length and nth(fx, i) < 6)
    .map(i => `${word(foes, i) == "Drone" ? "drone" : "hound"}:${foeTx(i, foes.length)}:${foeTy(i)}:${nth(fx, i) > 0 ? nth(fx, i) : (nth(juggle, i) > 0 ? 7 : 0)}`).join(";"))
  // The enemy window lists names (yellow while staggered). Under each enemy,
  // on the backdrop, its HP bar; the stagger panel, top left, follows the
  // enemy last targeted.
  derive foeLines = [0, 1].filter(i => i < foes.length).map(i => (nth(foeHp, i) <= 0 ? ""
    : (nth(brk, i) > 0 ? `{${word(foes, i)}}` : word(foes, i))))
  derive hpBars = ([0, 1].filter(i => i < foes.length and nth(foeHp, i) > 0).map(i =>
    `@${foeTx(i, foes.length)},${labelRow()}|${gauge(nth(foeHp, i) / foeOf(word(foes, i)).hp * 64, 8)}`))
  derive panel = (foes.length > 0 and nth(foeHp, aimAt) > 0
    ? [`0,0,12,4|${panelName(word(foes, aimAt), nth(chain, aimAt), nth(brk, aimAt))}|${panelBar(nth(chain, aimAt), nth(brk, aimAt), foeOf(word(foes, aimAt)).breakAt)}`] : [])
  // The chooser: the commands, or, while picking a target, the enemies.
  derive menuLines = (ui == "target"
    ? [" {Target}"].concat([0, 1].filter(i => i < foes.length).map(i => (nth(foeHp, i) > 0 ? ` ${word(foes, i)}` : "")))
    : (ui == "stance" ? [` ${stanceName(0)}`, ` ${stanceName(1)}`, ` ${stanceName(2)}`, ` ${stanceName(3)}`]
    : (ui == "item" ? [" Potion", `   x${potions}`]
    : [" Auto", ` ${abilityOf(roleOf(stance, 0), 0)}`, ` ${abilityOf(roleOf(stance, 0), 1)}`, " Item"])))
  // Thunda's ATB, above the commands: her slots, each an ability over its own
  // segment filling. Committed slots turn yellow; while she acts, each
  // command leaves the bar as it finishes. One slot, uncommitted: Right goes.
  derive rookActing = play == "act" and actor == 0
  derive shown = rookActing ? queue.slice(qi) : plan
  derive locked = committed or rookActing
  derive seg1 = min(24, nth(atb, 0) * 2)
  derive seg2 = max(0, (nth(atb, 0) - 12) * 2)
  // A slot shows only once it holds an ability.
  // Thunda's ATB bar, always above the chooser: two segments of 8 tiles.
  // Once something is slotted, its name sits over its segment.
  derive atbLine = `${gauge(seg1 / 24 * 64, 8)}  ${gauge(seg2 / 24 * 64, 8)}`
  derive slotNames = `${slotText(word(shown, 0), locked)}    ${slotText(word(shown, 1), locked)}${shown.length == 1 and not locked ? "  >Go" : ""}`
  // The title is the stance; its arrow says Left changes it.
  // Each member on a line: name, role in yellow, HP.
  derive statusLines = ([`<${stanceName(stance)}`].concat([0, 1, 2].map(i =>
    `${padTo(nameOf(i), 8)} {${padTo(roleOf(stance, i), 6)}} ${pad3(nth(hp, i))}`)))
  derive stanceLines = [` ${stanceName(0)}`, ` ${stanceName(1)}`, ` ${stanceName(2)}`, ` ${stanceName(3)}`]
  derive rankLines = ["{Victory!}", `Time  ${clockOf(bticks)}`, `Rank  ${starLine(rank)}`].concat(found ? ["Found a Potion."] : [])
  // The top window: a stance's roles while choosing one, else what is playing.
  derive topMsg = ui == "stance" and fighting ? `${roleOf(stanceCursor, 0)} ${roleOf(stanceCursor, 1)} ${roleOf(stanceCursor, 2)}` : msg
  derive battleWindows = ([`10,20,22,10,2|${statusLines.join("|")}`]
    .concat(chooserShown ? [`0,20,10,10,2|${menuLines.join("|")}`] : [])
    .concat(fighting ? (shown.length > 0 ? [`0,16,21,4|${slotNames}|${atbLine}`] : [`0,17,21,3|${atbLine}`]) : [])
    .concat(hpBars)
    .concat(fighting ? panel : [])
    .concat(topMsg != "" ? [`12,1,20,3|${topMsg}`] : [])
    .concat(phase == "won" ? [`7,6,18,10,2|${rankLines.join("|")}`] : []).join("^"))

  // ── Walking ──

  task walkClock when scene == "field" and fading == "" and not talking and (moving or held != "")
    every(33, walkTick)
  action walkTick
    if moving
      let o = off + 2
      if o >= 16
        arrive()
      else
        off = o
    else
      tryStep(tx, ty, held)

  action tryStep(x: number, y: number, d: string)
    if d != ""
      dir = d
      moving = not blocked(x + dx(d), y + dy(d))
      off = 0

  action arrive
    let nx = tx + dx(dir)
    let ny = ty + dy(dir)
    let r = nextRng(rng)
    let since = sinceFight + 1
    tx = nx
    ty = ny
    off = 0
    moving = false
    steps = steps + 1
    rng = r
    sinceFight = since
    if thicket(nx, ny) and since >= 4 and r % 100 < 16
      startFight(r)
    else
      tryStep(nx, ny, held)

  action talk
    let who = npcAt(tx + dx(dir), ty + dy(dir))
    talkTo = who

  // ── Into and out of battle ──

  action startFight(r: number)
    let g = group(r % 3)
    foes = g
    foeHp = g.map(n => foeOf(n).hp)
    chain = g.map(n => 100)
    brk = g.map(n => 0)
    foeAtb = g.map(n => r % 9)
    fx = g.map(n => 0)
    hold = g.map(n => 0)
    juggle = g.map(n => 0)
    atb = [r % 8, r % 5, r % 7]
    phase = "intro"
    ui = "menu"
    cursor = 0
    plan = []
    planAims = []
    committed = false
    rush = false
    play = ""
    msg = ""
    held = ""
    moving = false
    provoke = -1
    steel = -1
    bticks = 0
    par = parOf(g)
    rank = 0
    found = false
    sinceFight = 0
    next = "battle"
    fading = "out"

  task fadeClock when fading != ""
    every(70, fadeTick)
  action fadeTick
    if fading == "out"
      if fade < 4
        fade = fade + 1
      else
        scene = next
        fading = "in"
    else
      if fade > 0
        fade = fade - 1
      else
        fading = ""
        if scene == "battle"
          phase = "fight"

  // After a fight the party is healed in full.
  action leaveBattle
    hp = [maxHp(0), maxHp(1), maxHp(2)]
    phase = ""
    play = ""
    msg = ""
    next = "field"
    fading = "out"

  action wipeOut
    hp = [maxHp(0), maxHp(1), maxHp(2)]
    potions = startPotions()
    tx = startX()
    ty = startY()
    dir = "down"
    phase = ""
    play = ""
    msg = ""
    next = "field"
    fading = "out"

  // ── The battle clock: in real time, gauges fill, chains drain, staggers
  // wear off; when nothing is playing, the next one ready acts ──

  task battleClock when inBattle and fading == ""
    every(50, battleTick)
  action battleTick
    let ks = [0, 1]
    let f0 = fx
    let h0 = foeHp
    fx = ks.filter(i => i < foes.length).map(i => (nth(f0, i) == 1 ? (nth(h0, i) > 0 ? 0 : 2) : (nth(f0, i) >= 2 ? min(6, nth(f0, i) + 1) : 0)))
    dmgT = max(0, dmgT - 1)
    if fighting
      let b0 = brk
      let c0 = chain
      let hd0 = hold
      let j0 = juggle
      let a0 = atb
      let fa0 = foeAtb
      // The one acting does not refill until its queue is done.
      let newAtb = [0, 1, 2].map(i => (nth(hp, i) <= 0 ? 0 : (play == "act" and actor == i ? nth(a0, i) : min(full(), nth(a0, i) + speedOf(i)))))
      // A juggled enemy's gauge does not fill: it is in the air.
      let newFoe = [0, 1].filter(i => i < foes.length).map(i => (nth(foeHp, i) > 0 ? (nth(j0, i) > 0 ? nth(fa0, i) : min(full(), nth(fa0, i) + foeOf(word(foes, i)).speed)) : 0))
      bticks = bticks + 1
      leap = play == "act" ? leap + 1 : 0
      juggle = ks.filter(i => i < foes.length).map(i => max(0, nth(j0, i) - 1))
      brk = ks.filter(i => i < foes.length).map(i => max(0, nth(b0, i) - 1))
      hold = ks.filter(i => i < foes.length).map(i => max(0, nth(hd0, i) - 1))
      chain = ks.filter(i => i < foes.length).map(i => (nth(b0, i) == 1 ? 100 : (nth(b0, i) > 0 ? nth(c0, i) : max(100, nth(c0, i) - drain(nth(hd0, i) > 0)))))
      atb = newAtb
      foeAtb = newFoe
      if play == ""
        dispatch(newAtb, newFoe)

  // The next to act: Thunda once her committed slots have their segments
  // filled (one ability needs one), then an ally with a full gauge, then an enemy.
  action dispatch(gauges: number[], foeGauges: number[])
    let allies = [1, 2].filter(i => nth(gauges, i) >= full() and nth(hp, i) > 0)
    let foeReady = [0, 1].filter(i => i < foes.length and nth(foeGauges, i) >= full() and nth(foeHp, i) > 0)
    let ready = floor(nth(gauges, 0) / segment())
    if committed and nth(hp, 0) > 0 and (ready >= plan.length or (rush and ready > 0))
      let p = plan.slice(0, min(plan.length, ready))
      let t = planAims.slice(0, min(plan.length, ready))
      rush = false
      plan = []
      planAims = []
      committed = false
      rookTurns = rookTurns + 1
      run(0, p, t, gauges)
    else
      if allies.length > 0
        autoAct(nth(allies, 0), gauges)
      else
        if foeReady.length > 0
          foeTurn(nth(foeReady, 0), foeGauges)

  // ── Thunda's input, open the whole fight ──
  // The first ability chosen fills slot one; choosing a second, then a
  // target, commits both. Auto fills both by her role, then asks the target.
  // Escape takes back the last slot (or un-commits).

  derive aimAt = nth(foeHp, focus) > 0 ? focus : (nth(foeHp, 0) > 0 ? 0 : 1)
  derive anyHurt = [0, 1, 2].filter(j => nth(hp, j) > 0 and nth(hp, j) * 4 < maxHp(j) * 3).length > 0

  action choose
    let role = roleOf(stance, 0)
    if cursor == 0
      plan = rolePlan(role, anyHurt, provoke == 0)
      target = aimAt
      ui = "target"
    else
      if cursor == 3
        ui = "item"
      else
        let name = abilityOf(role, cursor - 1)
        if plan.length == 0
          plan = [name]
        else
          let p = [word(plan, 0), name]
          plan = p
          if needsTarget(word(p, 0)) or needsTarget(name)
            target = aimAt
            ui = "target"
          else
            commit(aimAt)

  // Commit what is queued, one slot or two; Right commits a single slot early.
  action goEarly
    if plan.length > 0 and not committed
      if needsTarget(word(plan, 0)) or needsTarget(word(plan, 1))
        target = aimAt
        ui = "target"
      else
        commit(aimAt)

  action commit(aim: number)
    planAims = [aim, aim]
    focus = aim
    committed = true
    ui = "menu"

  action unslot
    if committed
      committed = false
      rush = false
    else
      plan = plan.slice(0, max(0, plan.length - 1))

  action usePotion
    if potions > 0
      plan = ["Potion"]
      commit(aimAt)

  // The stance menu, to the left of the commands: free, any time.
  action openStances
    stanceCursor = stance
    ui = "stance"
  action pickStance
    stance = stanceCursor
    if not committed
      plan = []
    ui = "menu"

  // An ally fills both segments by its role, at Thunda's target, and acts.
  action autoAct(i: number, gauges: number[])
    lastAuto = nameOf(i)
    run(i, rolePlan(roleOf(stance, i), anyHurt, provoke == i), [aimAt, aimAt], gauges)

  action retarget
    let other = target == 0 ? 1 : 0
    if other < foes.length and nth(foeHp, other) > 0
      target = other

  // ── Playing an action: a step forward, each queued ability, a step back ──

  action run(who: number, actions: string[], aims: number[], gauges: number[])
    actor = who
    queue = actions
    qAims = aims
    qi = 0
    step = 0
    leap = 0
    atb = gauges
    msg = announce(word(actions, 0))
    play = "act"

  task windUp when play != "" and step == 0 key=`${play}-${actor}-${qi}-${bticks > 0}`
    after(220, actStep)
  task followThrough when play != "" and step == 1 key=`${play}-${actor}-${qi}`
    after(320, actStep)
  action actStep
    if step == 0
      if play == "act"
        applyMember()
      else
        applyFoe()
      step = 1
    else
      let n = qi + 1
      let left = [0, 1].filter(i => i < foes.length and nth(foeHp, i) > 0).length
      // Each command leaves the ATB bar as it finishes.
      if play == "act"
        atb = put(atb, actor, max(0, nth(atb, actor) - segment()))
      if play == "act" and n < queue.length and left > 0
        qi = n
        step = 0
        leap = 0
        msg = announce(word(queue, n))
      else
        settle()

  action applyMember
    let c = word(queue, qi)
    let aim0 = nth(qAims, qi)
    let t = nth(foeHp, aim0) > 0 ? aim0 : (aim0 == 0 ? 1 : 0)
    let r = nextRng(rng)
    rng = r
    if needsTarget(c)
      let foe = foeOf(word(foes, t))
      let ch = nth(chain, t)
      let broken = nth(brk, t) > 0
      let d = hitFor(power(c, atkOf(actor)), ch, broken, r)
      let up = chainUp(ch, chainGain(c), broken)
      let breaks = not broken and up >= foe.breakAt
      let hpBefore = nth(foeHp, t)
      foeHp = put(foeHp, t, max(0, hpBefore - d))
      chain = put(chain, t, min(maxChain(), breaks ? up + 50 : up))
      brk = breaks ? put(brk, t, staggerTicks()) : brk
      hold = isStrike(c) ? put(hold, t, 40) : hold
      // Strike hits on a staggered enemy launch it and keep it in the air.
      if isStrike(c) and broken and hpBefore > d
        juggle = put(juggle, t, juggleTicks())
        juggles = juggles + 1
      fx = put(fx, t, 1)
      dmgText = `${d}`
      dmgX = foeTx(t, foes.length) * 8 + 24
      dmgY = foeTy(t) * 8
      dmgT = 16
      if breaks
        staggers = staggers + 1
        msg = `${foe.name} staggers!`
    else
      if c == "Cure"
        let who = lowest(hp)
        let amount = min(40, maxHp(who) - nth(hp, who))
        hp = put(hp, who, nth(hp, who) + amount)
        dmgText = `${amount}`
        dmgX = partyX(who)
        dmgY = partyY(who) - 6
        dmgT = 16
      else
        if c == "Potion" or c == "Heal"
          let amount = c == "Potion" ? potionHeal() : 18
          let h1 = hp
          hp = [0, 1, 2].map(i => (nth(h1, i) > 0 ? min(maxHp(i), nth(h1, i) + amount) : 0))
          potions = c == "Potion" ? potions - 1 : potions
          dmgText = `${amount}`
          dmgX = partyX(1)
          dmgY = partyY(1) - 6
          dmgT = 16
        else
          if c == "Taunt"
            provoke = actor
          else
            steel = actor

  // An enemy's plain attack: no message, as in the old games.
  action foeTurn(i: number, gauges: number[])
    foeAtb = put(gauges, i, 0)
    actor = i
    queue = ["attack"]
    qi = 0
    step = 0
    msg = ""
    play = "foeAct"

  action applyFoe
    let r = nextRng(rng)
    let alive = [0, 1, 2].filter(i => nth(hp, i) > 0)
    let guard = [0, 1, 2].filter(i => nth(hp, i) > 0 and roleOf(stance, i) == "Guard")
    let who = provoke >= 0 and nth(hp, provoke) > 0 ? provoke : (guard.length > 0 ? nth(guard, 0) : nth(alive, r % max(1, alive.length)))
    let base = foeOf(word(foes, actor)).atk + r % 6
    let d = steel == who and roleOf(stance, who) == "Guard" ? floor(base / 4) : (roleOf(stance, who) == "Guard" ? floor(base / 2) : base)
    rng = r
    hp = put(hp, who, max(0, nth(hp, who) - d))
    dmgText = `${d}`
    dmgX = partyX(who)
    dmgY = partyY(who) - 6
    dmgT = 16

  action settle
    let foesLeft = [0, 1].filter(i => i < foes.length and nth(foeHp, i) > 0).length
    let partyLeft = [0, 1, 2].filter(i => nth(hp, i) > 0).length
    step = 0
    play = ""
    msg = ""
    if foesLeft == 0
      wins = wins + 1
      let r5 = stars(bticks, par)
      rank = r5
      found = r5 == 5
      potions = r5 == 5 ? potions + 1 : potions
      phase = "won"
    else
      if partyLeft == 0 or nth(hp, 0) <= 0
        msg = "Thunda has fallen."
        phase = "lost"

  // ── Keys ──

  action onKey(k: string, e: KeyboardEvent)
    let d = keyDir(k)
    if d != "" or confirmKey(k) or cancelKey(k)
      preventDefault()
    if fading == ""
      if inBattle
        battleKey(k, d)
      else
        if talking
          if confirmKey(k)
            talkTo = -1
        else
          if d != ""
            held = d
          else
            if confirmKey(k) and not moving
              talk()

  action battleKey(k: string, d: string)
    if fighting
      menuKey(k, d)
    else
      if phase == "won" and confirmKey(k)
        leaveBattle()
      else
        if phase == "lost" and confirmKey(k)
          wipeOut()

  action menuKey(k: string, d: string)
    if ui == "menu"
      if d == "up"
        cursor = (cursor + 3) % 4
      else
        if d == "down"
          cursor = (cursor + 1) % 4
        else
          if d == "left"
            openStances()
          else
            if d == "right"
              goEarly()
            else
              if confirmKey(k)
                if committed
                  rush = true
                else
                  choose()
              else
                if cancelKey(k)
                  unslot()
    if ui == "stance"
      if d == "up"
        stanceCursor = (stanceCursor + stances() - 1) % stances()
      else
        if d == "down"
          stanceCursor = (stanceCursor + 1) % stances()
        else
          if confirmKey(k)
            pickStance()
          else
            if d == "right" or cancelKey(k)
              ui = "menu"
    if ui == "item"
      if confirmKey(k)
        usePotion()
      else
        if d == "right" or cancelKey(k)
          ui = "menu"
    if ui == "target"
      if d == "up" or d == "down" or d == "left" or d == "right"
        retarget()
      else
        if confirmKey(k)
          commit(target)
        else
          if cancelKey(k)
            plan = plan.length > 1 ? plan.slice(0, 1) : []
            ui = "menu"

  action onKeyUp(k: string)
    if keyDir(k) == held
      held = ""

  view
    main testId="root" key=onKey keyup=onKeyUp width="100%" height="100%" background-color="#000000"
      canvas surface=ppu((inBattle ? "battle" : "field"), camX, camY,
        (inBattle ? battleSprites.join(";") : fieldSprites.join(";")),
        (inBattle ? battleWindows : fieldWindows), (inBattle ? enemySpec : ""), fade)
        width="100%" height="100%" testId="screen"
      if inBattle
        text phase testId="phase" position="absolute" left=-9999 top=0
