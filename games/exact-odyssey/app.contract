// Exact Odyssey: an RPG drawn by an NES-style picture processor (the `ppu`
// surface in gpu/, on the nes-ppu engine in engines/). This file is the game:
// it walks the field, starts fights, runs the battle, and tells the surface
// what is on screen as small text specs (see gpu/src/lib.rs).
use Npc, fieldMap, tileAt, walkable, thicket, npcs, npcAt, blocked, dx, dy, camAxis, nextRng from "./field.contract"
use Foe, foeOf, group, foeTx, foeTy, nameOf, maxHp, atkOf, speedOf, full, stanceName, roleOf, skillOf, needsTarget, power, chainGain, hitFor, commandAt, lowest, nth, word, put, pad3, padTo, gauge from "./battle.contract"

fn keyDir(k: string): string = (k == "ArrowUp" or k == "w" ? "up" : (k == "ArrowDown" or k == "s" ? "down"
  : (k == "ArrowLeft" or k == "a" ? "left" : (k == "ArrowRight" or k == "d" ? "right" : ""))))
fn confirmKey(k: string): bool = k == " " or k == "Enter" or k == "z"
fn cancelKey(k: string): bool = k == "Escape" or k == "x"
fn startX(): number = 11
fn startY(): number = 7
fn partyX(i: number): number = (i == 1 ? 208 : 200)
fn partyY(i: number): number = 56 + i * 32

component ExactOdyssey
  // ── The field ──
  state tx = 11
  state ty = 7
  state dir = "down"
  state off = 0
  state moving = false
  state steps = 0
  state held = ""
  state talkTo = -1
  state rng = 7
  state sinceFight = 0
  // ── Scenes and fades ──
  state scene = "field"
  state fade = 0
  state fading = ""
  state next = ""
  // ── The battle ──
  state foes: string[] = []
  state foeHp: number[] = []
  state chain: number[] = []
  state brk: number[] = []
  state foeAtb: number[] = []
  state fx: number[] = []
  state hp: number[] = [120, 100, 90]
  state atb: number[] = [0, 0, 0]
  state stance = 0
  state phase = ""
  state actor = 0
  state cursor = 0
  state cmd = ""
  state target = 0
  state step = 0
  state msg = ""
  state dmgText = ""
  state dmgX = 0
  state dmgY = 0
  state dmgT = 0
  state provoke = -1
  state wins = 0

  // ── What is on screen ──
  derive px = tx * 16 + dx(dir) * off
  derive py = ty * 16 + dy(dir) * off
  derive camX = camAxis(px, 120, 512, 256)
  derive camY = camAxis(py, 112, 320, 240)
  derive frameNo = (steps + (off >= 8 ? 1 : 0)) % 2
  derive heroName = `${dir == "right" ? "left" : dir}${frameNo}`
  derive talking = talkTo >= 0
  derive talkLines = match npcs().at(talkTo) { case some(n) => n.lines, case none => [] }
  // While a window is open, sprites low on the screen would cover it.
  derive fieldSprites = ((not talking or py - camY < 136 ? [`${heroName}:${px - camX}:${py - camY}:${dir == "right" ? "h" : ""}`] : [])
    .concat(npcs().filter(n => not talking or n.y * 16 - camY < 136).map(n => `villager:${n.x * 16 - camX}:${n.y * 16 - camY}:`)))
  derive fieldWindows = talking ? `1,19,30,10|${talkLines.join("|")}` : ""

  derive acting = (phase == "act" and step == 0) or (phase == "act" and step == 1)
  derive partySprites = [0, 1, 2].map(i => `${nth(hp, i) <= 0 ? "ko" : (acting and actor == i ? "strike" : "idle")}:${partyX(i) - (acting and actor == i ? 16 : 0)}:${partyY(i)}:${i}`)
  derive handSprite = (phase == "menu" ? [`hand:${10 * 8 - 6}:${(21 + cursor) * 8}:`]
    : (phase == "target" ? [`hand:${foeTx(target) * 8 - 18}:${foeTy(target) * 8 + 12}:`] : []))
  derive dmgSprite = dmgT > 0 ? [`#${dmgText}:${dmgX}:${dmgY - (dmgT > 12 ? (16 - dmgT) * 2 : 8)}:3`] : []
  derive battleSprites = partySprites.concat(handSprite).concat(dmgSprite)
  derive enemySpec = ([0, 1].filter(i => i < foes.length and nth(fx, i) < 6)
    .map(i => `${word(foes, i) == "DRONE" ? "drone" : "hound"}:${foeTx(i)}:${foeTy(i)}:${nth(fx, i)}`).join(";"))
  derive foeLines = ([0, 1].filter(i => i < foes.length).map(i => (nth(foeHp, i) <= 0 ? ["", ""]
    : [word(foes, i), (nth(brk, i) > 0 ? "BREAK!" : `${gauge((nth(chain, i) - 100) / (foeOf(word(foes, i)).breakAt - 100) * 32, 4)}`)])).flat())
  derive menuLines = (phase == "menu" or phase == "target"
    ? ["FIGHT", skillOf(roleOf(stance, actor)), "STANCE", "FLEE"] : [])
  derive statusLines = ([stanceName(stance)].concat([0, 1, 2].map(i => [
    `${padTo(nameOf(i), 4)} ${pad3(nth(hp, i))} ${gauge(nth(atb, i), 3)}`, ` ${roleOf(stance, i)}`]).flat()))
  derive battleWindows = ([`0,20,10,10|${foeLines.join("|")}`, `10,20,8,10|${menuLines.join("|")}`,
    `18,20,14,10|${statusLines.join("|")}`].concat(msg != "" ? [`6,1,20,3|${msg}`] : []).join("^"))
  derive inBattle = scene == "battle"

  // ── Walking ──

  task walkClock when scene == "field" and fading == "" and not talking and (moving or held != "")
    every(33, walkTick)
  action walkTick
    if moving
      let o = off + 2
      if o >= 16
        arrive()
      else
        off = o
    else
      tryStep(tx, ty, held)

  action tryStep(x: number, y: number, d: string)
    if d != ""
      dir = d
      moving = not blocked(x + dx(d), y + dy(d))
      off = 0

  action arrive
    let nx = tx + dx(dir)
    let ny = ty + dy(dir)
    let r = nextRng(rng)
    let since = sinceFight + 1
    tx = nx
    ty = ny
    off = 0
    moving = false
    steps = steps + 1
    rng = r
    sinceFight = since
    if thicket(nx, ny) and since >= 4 and r % 100 < 16
      startFight(r)
    else
      tryStep(nx, ny, held)

  action talk
    let who = npcAt(tx + dx(dir), ty + dy(dir))
    talkTo = who

  // ── Into and out of battle ──

  action startFight(r: number)
    let g = group(r % 3)
    foes = g
    foeHp = g.map(n => foeOf(n).hp)
    chain = g.map(n => 100)
    brk = g.map(n => 0)
    foeAtb = g.map(n => r % 9)
    fx = g.map(n => 0)
    atb = [r % 8, r % 5, r % 7]
    phase = "intro"
    msg = ""
    held = ""
    moving = false
    provoke = -1
    sinceFight = 0
    next = "battle"
    fading = "out"

  task fadeClock when fading != ""
    every(70, fadeTick)
  action fadeTick
    if fading == "out"
      if fade < 4
        fade = fade + 1
      else
        scene = next
        fading = "in"
    else
      if fade > 0
        fade = fade - 1
      else
        fading = ""
        if scene == "battle"
          phase = "wait"

  action leaveBattle
    hp = hp.map(h => max(1, h))
    phase = ""
    msg = ""
    next = "field"
    fading = "out"

  action wipeOut
    hp = [maxHp(0), maxHp(1), maxHp(2)]
    tx = startX()
    ty = startY()
    dir = "down"
    phase = ""
    msg = ""
    next = "field"
    fading = "out"

  // ── The battle clock: gauges fill, effects play, the chain drains ──

  task battleClock when inBattle and fading == ""
    every(50, battleTick)
  action battleTick
    let ks = [0, 1]
    let f0 = fx
    let h0 = foeHp
    fx = ks.filter(i => i < foes.length).map(i => (nth(f0, i) == 1 ? (nth(h0, i) > 0 ? 0 : 2) : (nth(f0, i) >= 2 ? min(6, nth(f0, i) + 1) : 0)))
    dmgT = max(0, dmgT - 1)
    let b0 = brk
    let c0 = chain
    brk = ks.filter(i => i < foes.length).map(i => max(0, nth(b0, i) - 1))
    chain = ks.filter(i => i < foes.length).map(i => (nth(b0, i) == 1 ? 100 : (nth(b0, i) > 0 ? nth(c0, i) : max(100, nth(c0, i) - 0.4))))
    if phase == "wait"
      fill()

  action fill
    let a0 = atb
    let fa0 = foeAtb
    let newAtb = [0, 1, 2].map(i => (nth(hp, i) > 0 ? min(full(), nth(a0, i) + speedOf(i)) : 0))
    let newFoe = [0, 1].filter(i => i < foes.length).map(i => (nth(foeHp, i) > 0 ? min(full(), nth(fa0, i) + foeOf(word(foes, i)).speed) : 0))
    let ready = [0, 1, 2].filter(i => nth(newAtb, i) >= full() and nth(hp, i) > 0)
    let foeReady = [0, 1].filter(i => i < foes.length and nth(newFoe, i) >= full() and nth(foeHp, i) > 0)
    atb = newAtb
    foeAtb = newFoe
    if ready.length > 0
      actor = nth(ready, 0)
      cursor = 0
      phase = "menu"
    else
      if foeReady.length > 0
        foeTurn(nth(foeReady, 0), newFoe)

  // ── Choosing ──

  action choose
    let c = commandAt(cursor)
    let name = c == "SKILL" ? skillOf(roleOf(stance, actor)) : c
    if c == "STANCE"
      let s = (stance + 1) % 3
      stance = s
      msg = `STANCE: ${stanceName(s)}`
    else
      if c == "FLEE"
        msg = "THE PARTY FLED."
        leaveBattle()
      else
        cmd = name
        if needsTarget(name)
          target = nth(foeHp, 0) > 0 ? 0 : 1
          phase = "target"
        else
          startAct(name)

  action retarget
    let other = target == 0 ? 1 : 0
    if other < foes.length and nth(foeHp, other) > 0
      target = other

  action startAct(name: string)
    cmd = name
    step = 0
    msg = `${nameOf(actor)} - ${name}`
    phase = "act"

  // ── Acting: a step forward, the hit, a step back ──

  task windUp when (phase == "act" or phase == "foeAct") and step == 0 key=`${phase}-${actor}-${msg}`
    after(380, actStep)
  task followThrough when (phase == "act" or phase == "foeAct") and step == 1 key=`${phase}-${actor}`
    after(650, actStep)
  action actStep
    if step == 0
      if phase == "act"
        applyMember()
      else
        applyFoe()
      step = 1
    else
      settle()

  action applyMember
    let r = nextRng(rng)
    rng = r
    atb = put(atb, actor, 0)
    if needsTarget(cmd)
      let foe = foeOf(word(foes, target))
      let ch = nth(chain, target)
      let broken = nth(brk, target) > 0
      let d = hitFor(power(cmd, atkOf(actor)), ch, broken, r)
      let up = ch + chainGain(cmd)
      let breaks = not broken and up >= foe.breakAt
      foeHp = put(foeHp, target, max(0, nth(foeHp, target) - d))
      chain = put(chain, target, min(999, breaks ? up + 50 : up))
      brk = breaks ? put(brk, target, 120) : brk
      fx = put(fx, target, 1)
      dmgText = `${d}`
      dmgX = foeTx(target) * 8 + 8
      dmgY = foeTy(target) * 8
      dmgT = 16
      if breaks
        msg = `${foe.name} IS BROKEN!`
    else
      if cmd == "CURE"
        let who = lowest(hp)
        let amount = min(40, maxHp(who) - nth(hp, who))
        hp = put(hp, who, nth(hp, who) + amount)
        dmgText = `${amount}`
        dmgX = partyX(who)
        dmgY = partyY(who) - 6
        dmgT = 16
      else
        provoke = actor
        msg = `FOES TURN ON ${nameOf(actor)}`

  action foeTurn(i: number, gauges: number[])
    foeAtb = put(gauges, i, 0)
    actor = i
    step = 0
    msg = `${word(foes, i)} ATTACKS`
    phase = "foeAct"

  action applyFoe
    let r = nextRng(rng)
    let alive = [0, 1, 2].filter(i => nth(hp, i) > 0)
    let guard = [0, 1, 2].filter(i => nth(hp, i) > 0 and roleOf(stance, i) == "GUARD")
    let who = provoke >= 0 and nth(hp, provoke) > 0 ? provoke : (guard.length > 0 ? nth(guard, 0) : nth(alive, r % max(1, alive.length)))
    let base = foeOf(word(foes, actor)).atk + r % 6
    let d = roleOf(stance, who) == "GUARD" ? floor(base / 2) : base
    rng = r
    hp = put(hp, who, max(0, nth(hp, who) - d))
    dmgText = `${d}`
    dmgX = partyX(who)
    dmgY = partyY(who) - 6
    dmgT = 16

  action settle
    let foesLeft = [0, 1].filter(i => i < foes.length and nth(foeHp, i) > 0).length
    let partyLeft = [0, 1, 2].filter(i => nth(hp, i) > 0).length
    step = 0
    if foesLeft == 0
      wins = wins + 1
      msg = "VICTORY!"
      phase = "won"
    else
      if partyLeft == 0
        msg = "THE PARTY FELL."
        phase = "lost"
      else
        msg = ""
        phase = "wait"

  // ── Keys ──

  action onKey(k: string, e: KeyboardEvent)
    let d = keyDir(k)
    if d != "" or confirmKey(k) or cancelKey(k)
      preventDefault()
    if fading == ""
      if inBattle
        battleKey(k, d)
      else
        if talking
          if confirmKey(k)
            talkTo = -1
        else
          if d != ""
            held = d
          else
            if confirmKey(k) and not moving
              talk()

  action battleKey(k: string, d: string)
    if phase == "menu"
      if d == "up"
        cursor = (cursor + 3) % 4
      else
        if d == "down"
          cursor = (cursor + 1) % 4
        else
          if confirmKey(k)
            choose()
    else
      if phase == "target"
        if d == "up" or d == "down"
          retarget()
        if confirmKey(k)
          startAct(cmd)
        if cancelKey(k)
          phase = "menu"
      else
        if phase == "won" and confirmKey(k)
          leaveBattle()
        if phase == "lost" and confirmKey(k)
          wipeOut()

  action onKeyUp(k: string)
    if keyDir(k) == held
      held = ""

  view
    main testId="root" key=onKey keyup=onKeyUp width="100%" height="100%" background-color="#000000"
      canvas surface=ppu((inBattle ? "battle" : "field"), camX, camY,
        (inBattle ? battleSprites.join(";") : fieldSprites.join(";")),
        (inBattle ? battleWindows : fieldWindows), (inBattle ? enemySpec : ""), fade)
        width="100%" height="100%" testId="screen"
      if inBattle
        text phase testId="phase" position="absolute" left=-9999 top=0
