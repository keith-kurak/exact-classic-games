// Exact Odyssey: an RPG drawn by an NES-style picture processor (the `ppu`
// surface in gpu/, on the nes-ppu engine in engines/). This file is the game:
// it walks the field, starts fights, runs the battle, and tells the surface
// what is on screen as small text specs (see gpu/src/lib.rs).
use Npc, fieldMap, tileAt, walkable, thicket, npcs, npcAt, blocked, dx, dy, camAxis, nextRng from "./field.contract"
use Foe, foeOf, group, foeTx, foeTy, labelRow, staggerText, potionHeal, startPotions, parOf, nameOf, maxHp, atkOf, speedOf, full, stances, stanceName, roleOf, abilityOf, needsTarget, isStrike, power, chainGain, hitFor, drain, staggerTicks, rolePlan, segments, announce, lowest, stars, starLine, clockOf, nth, word, put, pad3, padTo, gauge from "./battle.contract"

fn keyDir(k: string): string = (k == "ArrowUp" or k == "w" ? "up" : (k == "ArrowDown" or k == "s" ? "down"
  : (k == "ArrowLeft" or k == "a" ? "left" : (k == "ArrowRight" or k == "d" ? "right" : ""))))
fn confirmKey(k: string): bool = k == " " or k == "Enter" or k == "z"
fn cancelKey(k: string): bool = k == "Escape" or k == "x"
fn startX(): number = 11
fn startY(): number = 7
fn partyX(i: number): number = (i == 1 ? 208 : 200)
fn partyY(i: number): number = 56 + i * 32

component ExactOdyssey
  // ── The field ──
  state tx = 11
  state ty = 7
  state dir = "down"
  state off = 0
  state moving = false
  state steps = 0
  state held = ""
  state talkTo = -1
  state rng = 7
  state sinceFight = 0
  // ── Scenes and fades ──
  state scene = "field"
  state fade = 0
  state fading = ""
  state next = ""
  // ── The battle ──
  state foes: string[] = []
  state foeHp: number[] = []
  state chain: number[] = []
  state brk: number[] = []
  state foeAtb: number[] = []
  state fx: number[] = []
  state hp: number[] = [120, 100, 90]
  state atb: number[] = [0, 0, 0]
  state stance = 0
  state phase = ""
  state actor = 0
  state cursor = 0
  state stanceCursor = 0
  // The last enemy Rook aimed at: the allies follow his lead.
  state focus = 0
  state lastAuto = ""
  state cmd = ""
  // Rook's choices for his two segments, and their targets.
  state plan: string[] = []
  state planAims: number[] = []
  // The abilities being carried out, their targets, and which is next.
  state queue: string[] = []
  state qAims: number[] = []
  state qi = 0
  state staggers = 0
  state target = 0
  state step = 0
  state msg = ""
  state dmgText = ""
  state dmgX = 0
  state dmgY = 0
  state dmgT = 0
  state provoke = -1
  state wins = 0
  // Ticks each enemy's chain stays steadied by a Strike hit.
  state hold: number[] = []
  // Each member's turn count, so allies alternate abilities.
  state turns: number[] = [0, 0, 0]
  state steel = -1
  // The fight's length and par in ticks, and its rank in stars.
  state bticks = 0
  state par = 0
  state rank = 0
  // The party leader's potions, kept between fights.
  state potions = 3
  state found = false

  // ── What is on screen ──
  derive px = tx * 16 + dx(dir) * off
  derive py = ty * 16 + dy(dir) * off
  derive camX = camAxis(px, 120, 512, 256)
  derive camY = camAxis(py, 112, 320, 240)
  // Feet always move, walking or standing: the surface steps any name
  // ending `*` in place from its frame counter.
  derive heroName = `${dir == "right" ? "left" : dir}*`
  derive talking = talkTo >= 0
  derive talkLines = match npcs().at(talkTo) { case some(n) => n.lines, case none => [] }
  // While a window is open, sprites low on the screen would cover it.
  derive fieldSprites = ((not talking or py - camY < 136 ? [`${heroName}:${px - camX}:${py - camY}:${dir == "right" ? "h" : ""}`] : [])
    .concat(npcs().filter(n => not talking or n.y * 16 - camY < 136).map(n => `villager*:${n.x * 16 - camX}:${n.y * 16 - camY}:`)))
  derive fieldWindows = talking ? `1,19,30,10,2|${talkLines.join("|")}` : ""

  derive acting = (phase == "act" and step == 0) or (phase == "act" and step == 1)
  derive partySprites = [0, 1, 2].map(i => `${nth(hp, i) <= 0 ? "ko" : (acting and actor == i ? "strike" : "idle")}:${partyX(i) - (acting and actor == i ? 16 : 0)}:${partyY(i)}:${i}`)
  derive handSprite = (phase == "menu" ? [`hand:${10 * 8 - 6}:${(21 + cursor * 2) * 8}:`]
    : (phase == "target" ? [`hand:${foeTx(target, foes.length) * 8 - 14}:${foeTy(target) * 8 + 24}:`]
    : (phase == "stance" ? [`hand:2:${(21 + stanceCursor * 2) * 8}:`]
    : (phase == "item" ? [`hand:2:${21 * 8}:`] : []))))
  derive dmgSprite = dmgT > 0 ? [`#${dmgText}:${dmgX}:${dmgY - (dmgT > 12 ? (16 - dmgT) * 2 : 8)}:3`] : []
  // OAM order is draw priority: damage numbers and the cursor in front.
  derive battleSprites = dmgSprite.concat(handSprite).concat(partySprites)
  derive enemySpec = ([0, 1].filter(i => i < foes.length and nth(fx, i) < 6)
    .map(i => `${word(foes, i) == "Drone" ? "drone" : "hound"}:${foeTx(i, foes.length)}:${foeTy(i)}:${nth(fx, i)}`).join(";"))
  // The enemy window lists names (yellow while staggered). Under each enemy
  // sprite, on the backdrop: its stagger bar and chain; staggered, the number
  // turns yellow and the bar drains as the stagger wears off.
  derive foeLines = [0, 1].filter(i => i < foes.length).map(i => (nth(foeHp, i) <= 0 ? ""
    : (nth(brk, i) > 0 ? `{${word(foes, i)}}` : word(foes, i))))
  derive staggerLabels = ([0, 1].filter(i => i < foes.length and nth(foeHp, i) > 0).map(i =>
    `@${foeTx(i, foes.length)},${labelRow()}|${staggerText(nth(chain, i), nth(brk, i), foeOf(word(foes, i)).breakAt)}`))
  derive choosing = phase == "menu" or phase == "target" or phase == "stance" or phase == "item" or phase == "confirm"
  derive menuLines = (choosing ? ["Auto", abilityOf(roleOf(stance, 0), 0), abilityOf(roleOf(stance, 0), 1), "Item"] : [])
  // Names in white, each role in yellow beneath.
  // The title is the stance; its arrow says Left changes it.
  derive statusLines = ([`<${stanceName(stance)}`].concat([0, 1, 2].map(i => [
    `${padTo(nameOf(i), 4)} ${pad3(nth(hp, i))}${gauge(nth(atb, i), 3)}`, `  {${roleOf(stance, i)}}`]).flat()))
  derive stanceLines = [` ${stanceName(0)}`, ` ${stanceName(1)}`, ` ${stanceName(2)}`, ` ${stanceName(3)}`]
  derive rankLines = ["{Victory!}", `Time  ${clockOf(bticks)}`, `Rank  ${starLine(rank)}`].concat(found ? ["Found a Potion."] : [])
  // While choosing a stance, the top window spells out its roles.
  // The top window: a stance's roles while choosing one; Rook's segments as
  // he fills them (Auto's plan waits for a confirm); else ability names.
  derive topMsg = (phase == "stance" ? `${roleOf(stanceCursor, 0)} ${roleOf(stanceCursor, 1)} ${roleOf(stanceCursor, 2)}`
    : (phase == "confirm" ? `${plan.join(" ")}  {OK?}` : (choosing and plan.length > 0 ? `${plan.join(" ")} ...` : msg)))
  derive battleWindows = ([`0,20,10,10,2|${foeLines.join("|")}`, `10,20,9,10,2|${menuLines.join("|")}`,
    `19,20,13,10|${statusLines.join("|")}`]
    .concat(staggerLabels)
    .concat(phase == "stance" ? [`0,20,10,10,2|${stanceLines.join("|")}`] : [])
    .concat(phase == "item" ? [`0,20,10,10,2| Potion|   x${potions}`] : [])
    .concat(topMsg != "" ? [`6,1,20,3|${topMsg}`] : [])
    .concat(phase == "won" ? [`7,6,18,10,2|${rankLines.join("|")}`] : []).join("^"))
  derive inBattle = scene == "battle"

  // ── Walking ──

  task walkClock when scene == "field" and fading == "" and not talking and (moving or held != "")
    every(33, walkTick)
  action walkTick
    if moving
      let o = off + 2
      if o >= 16
        arrive()
      else
        off = o
    else
      tryStep(tx, ty, held)

  action tryStep(x: number, y: number, d: string)
    if d != ""
      dir = d
      moving = not blocked(x + dx(d), y + dy(d))
      off = 0

  action arrive
    let nx = tx + dx(dir)
    let ny = ty + dy(dir)
    let r = nextRng(rng)
    let since = sinceFight + 1
    tx = nx
    ty = ny
    off = 0
    moving = false
    steps = steps + 1
    rng = r
    sinceFight = since
    if thicket(nx, ny) and since >= 4 and r % 100 < 16
      startFight(r)
    else
      tryStep(nx, ny, held)

  action talk
    let who = npcAt(tx + dx(dir), ty + dy(dir))
    talkTo = who

  // ── Into and out of battle ──

  action startFight(r: number)
    let g = group(r % 3)
    foes = g
    foeHp = g.map(n => foeOf(n).hp)
    chain = g.map(n => 100)
    brk = g.map(n => 0)
    foeAtb = g.map(n => r % 9)
    fx = g.map(n => 0)
    hold = g.map(n => 0)
    turns = [0, 0, 0]
    steel = -1
    bticks = 0
    par = parOf(g)
    rank = 0
    found = false
    atb = [r % 8, r % 5, r % 7]
    phase = "intro"
    msg = ""
    held = ""
    moving = false
    provoke = -1
    sinceFight = 0
    next = "battle"
    fading = "out"

  task fadeClock when fading != ""
    every(70, fadeTick)
  action fadeTick
    if fading == "out"
      if fade < 4
        fade = fade + 1
      else
        scene = next
        fading = "in"
    else
      if fade > 0
        fade = fade - 1
      else
        fading = ""
        if scene == "battle"
          phase = "wait"

  action leaveBattle
    hp = hp.map(h => max(1, h))
    phase = ""
    msg = ""
    next = "field"
    fading = "out"

  action wipeOut
    hp = [maxHp(0), maxHp(1), maxHp(2)]
    potions = startPotions()
    tx = startX()
    ty = startY()
    dir = "down"
    phase = ""
    msg = ""
    next = "field"
    fading = "out"

  // ── The battle clock. Time runs only while gauges fill: then chains drain
  // and staggers wear off; menus and animations stop the clock. ──

  task battleClock when inBattle and fading == ""
    every(50, battleTick)
  action battleTick
    let ks = [0, 1]
    let f0 = fx
    let h0 = foeHp
    fx = ks.filter(i => i < foes.length).map(i => (nth(f0, i) == 1 ? (nth(h0, i) > 0 ? 0 : 2) : (nth(f0, i) >= 2 ? min(6, nth(f0, i) + 1) : 0)))
    dmgT = max(0, dmgT - 1)
    if phase != "won" and phase != "lost"
      bticks = bticks + 1
    if phase == "wait"
      let b0 = brk
      let c0 = chain
      let hd0 = hold
      brk = ks.filter(i => i < foes.length).map(i => max(0, nth(b0, i) - 1))
      hold = ks.filter(i => i < foes.length).map(i => max(0, nth(hd0, i) - 1))
      chain = ks.filter(i => i < foes.length).map(i => (nth(b0, i) == 1 ? 100 : (nth(b0, i) > 0 ? nth(c0, i) : max(100, nth(c0, i) - drain(nth(hd0, i) > 0)))))
      fill()

  action fill
    let a0 = atb
    let fa0 = foeAtb
    let newAtb = [0, 1, 2].map(i => (nth(hp, i) > 0 ? min(full(), nth(a0, i) + speedOf(i)) : 0))
    let newFoe = [0, 1].filter(i => i < foes.length).map(i => (nth(foeHp, i) > 0 ? min(full(), nth(fa0, i) + foeOf(word(foes, i)).speed) : 0))
    let ready = [0, 1, 2].filter(i => nth(newAtb, i) >= full() and nth(hp, i) > 0)
    let foeReady = [0, 1].filter(i => i < foes.length and nth(newFoe, i) >= full() and nth(foeHp, i) > 0)
    atb = newAtb
    foeAtb = newFoe
    if ready.includes(0)
      actor = 0
      cursor = 0
      plan = []
      planAims = []
      phase = "menu"
    else
      if ready.length > 0
        autoAct(nth(ready, 0))
      else
        if foeReady.length > 0
          foeTurn(nth(foeReady, 0), newFoe)

  // ── Rook's turn: fill both ATB segments, then act ──
  // Each ability fills a segment; when both are full he acts. Auto fills both
  // by his role and waits for a confirm. Escape takes back the last segment.

  derive aimAt = nth(foeHp, focus) > 0 ? focus : (nth(foeHp, 0) > 0 ? 0 : 1)
  derive anyHurt = [0, 1, 2].filter(j => nth(hp, j) > 0 and nth(hp, j) * 4 < maxHp(j) * 3).length > 0

  action choose
    let role = roleOf(stance, 0)
    if cursor == 0
      plan = rolePlan(role, anyHurt, provoke == 0)
      planAims = [aimAt, aimAt]
      phase = "confirm"
    else
      if cursor == 3
        phase = "item"
      else
        let name = abilityOf(role, cursor - 1)
        if needsTarget(name)
          cmd = name
          target = aimAt
          phase = "target"
        else
          addSlot(name, aimAt)

  action addSlot(name: string, aim: number)
    let p = plan.concat([name])
    let t = planAims.concat([aim])
    if needsTarget(name)
      focus = aim
    if p.length >= segments()
      plan = []
      planAims = []
      run(0, p, t)
    else
      plan = p
      planAims = t
      phase = "menu"

  action unslot
    plan = plan.slice(0, max(0, plan.length - 1))
    planAims = planAims.slice(0, max(0, planAims.length - 1))

  // The item menu, to the left of the commands: a Potion takes both segments.
  action usePotion
    if potions > 0
      plan = []
      planAims = []
      run(0, ["Potion"], [0])

  // The stance menu, to the left of the commands: free, then back to them.
  action openStances
    stanceCursor = stance
    phase = "stance"
  action pickStance
    stance = stanceCursor
    plan = []
    planAims = []
    msg = `Stance: ${stanceName(stanceCursor)}`
    phase = "menu"

  // An ally fills both segments by its role, at Rook's target, and acts.
  action autoAct(i: number)
    lastAuto = nameOf(i)
    run(i, rolePlan(roleOf(stance, i), anyHurt, provoke == i), [aimAt, aimAt])

  action retarget
    let other = target == 0 ? 1 : 0
    if other < foes.length and nth(foeHp, other) > 0
      target = other

  // ── Acting: a step forward, each queued ability in turn, a step back ──

  action run(who: number, actions: string[], aims: number[])
    actor = who
    queue = actions
    qAims = aims
    qi = 0
    step = 0
    msg = announce(word(actions, 0))
    phase = "act"

  task windUp when (phase == "act" or phase == "foeAct") and step == 0 key=`${phase}-${actor}-${qi}`
    after(300, actStep)
  task followThrough when (phase == "act" or phase == "foeAct") and step == 1 key=`${phase}-${actor}-${qi}`
    after(420, actStep)
  action actStep
    if step == 0
      if phase == "act"
        applyMember()
      else
        applyFoe()
      step = 1
    else
      let n = qi + 1
      let left = [0, 1].filter(i => i < foes.length and nth(foeHp, i) > 0).length
      if phase == "act" and n < queue.length and left > 0
        qi = n
        step = 0
        msg = announce(word(queue, n))
      else
        settle()

  action applyMember
    let c = word(queue, qi)
    let aim0 = nth(qAims, qi)
    let t = nth(foeHp, aim0) > 0 ? aim0 : (aim0 == 0 ? 1 : 0)
    let r = nextRng(rng)
    rng = r
    atb = put(atb, actor, 0)
    if needsTarget(c)
      let foe = foeOf(word(foes, t))
      let ch = nth(chain, t)
      let broken = nth(brk, t) > 0
      let d = hitFor(power(c, atkOf(actor)), ch, broken, r)
      let up = ch + chainGain(c)
      let breaks = not broken and up >= foe.breakAt
      target = t
      foeHp = put(foeHp, t, max(0, nth(foeHp, t) - d))
      chain = put(chain, t, min(999, breaks ? up + 50 : up))
      brk = breaks ? put(brk, t, staggerTicks()) : brk
      hold = isStrike(c) ? put(hold, t, 40) : hold
      fx = put(fx, t, 1)
      dmgText = `${d}`
      dmgX = foeTx(t, foes.length) * 8 + 24
      dmgY = foeTy(t) * 8
      dmgT = 16
      if breaks
        staggers = staggers + 1
        msg = `${foe.name} staggers!`
    else
      if c == "Cure"
        let who = lowest(hp)
        let amount = min(40, maxHp(who) - nth(hp, who))
        hp = put(hp, who, nth(hp, who) + amount)
        dmgText = `${amount}`
        dmgX = partyX(who)
        dmgY = partyY(who) - 6
        dmgT = 16
      else
        if c == "Potion" or c == "Heal"
          let amount = c == "Potion" ? potionHeal() : 18
          let h1 = hp
          hp = [0, 1, 2].map(i => (nth(h1, i) > 0 ? min(maxHp(i), nth(h1, i) + amount) : 0))
          potions = c == "Potion" ? potions - 1 : potions
          dmgText = `${amount}`
          dmgX = partyX(1)
          dmgY = partyY(1) - 6
          dmgT = 16
        else
          if c == "Provoke"
            provoke = actor
          else
            steel = actor

  // An enemy's plain attack: no message, as in the old games.
  action foeTurn(i: number, gauges: number[])
    foeAtb = put(gauges, i, 0)
    actor = i
    queue = ["attack"]
    qi = 0
    step = 0
    msg = ""
    phase = "foeAct"

  action applyFoe
    let r = nextRng(rng)
    let alive = [0, 1, 2].filter(i => nth(hp, i) > 0)
    let guard = [0, 1, 2].filter(i => nth(hp, i) > 0 and roleOf(stance, i) == "Guard")
    let who = provoke >= 0 and nth(hp, provoke) > 0 ? provoke : (guard.length > 0 ? nth(guard, 0) : nth(alive, r % max(1, alive.length)))
    let base = foeOf(word(foes, actor)).atk + r % 6
    let d = steel == who and roleOf(stance, who) == "Guard" ? floor(base / 4) : (roleOf(stance, who) == "Guard" ? floor(base / 2) : base)
    rng = r
    hp = put(hp, who, max(0, nth(hp, who) - d))
    dmgText = `${d}`
    dmgX = partyX(who)
    dmgY = partyY(who) - 6
    dmgT = 16

  action settle
    let foesLeft = [0, 1].filter(i => i < foes.length and nth(foeHp, i) > 0).length
    let partyLeft = [0, 1, 2].filter(i => nth(hp, i) > 0).length
    step = 0
    if foesLeft == 0
      wins = wins + 1
      let r5 = stars(bticks, par)
      rank = r5
      found = r5 == 5
      potions = r5 == 5 ? potions + 1 : potions
      msg = ""
      phase = "won"
    else
      if partyLeft == 0 or nth(hp, 0) <= 0
        msg = "Rook has fallen."
        phase = "lost"
      else
        msg = ""
        phase = "wait"

  // ── Keys ──

  action onKey(k: string, e: KeyboardEvent)
    let d = keyDir(k)
    if d != "" or confirmKey(k) or cancelKey(k)
      preventDefault()
    if fading == ""
      if inBattle
        battleKey(k, d)
      else
        if talking
          if confirmKey(k)
            talkTo = -1
        else
          if d != ""
            held = d
          else
            if confirmKey(k) and not moving
              talk()

  action battleKey(k: string, d: string)
    if phase == "menu"
      if d == "up"
        cursor = (cursor + 3) % 4
      else
        if d == "down"
          cursor = (cursor + 1) % 4
        else
          if d == "left"
            openStances()
          else
            if confirmKey(k)
              choose()
            else
              if cancelKey(k)
                unslot()
    if phase == "confirm"
      if confirmKey(k)
        let p = plan
        let t = planAims
        plan = []
        planAims = []
        run(0, p, t)
      else
        if cancelKey(k)
          plan = []
          planAims = []
          phase = "menu"
    if phase == "stance"
      if d == "up"
        stanceCursor = (stanceCursor + stances() - 1) % stances()
      else
        if d == "down"
          stanceCursor = (stanceCursor + 1) % stances()
        else
          if confirmKey(k)
            pickStance()
          else
            if d == "right" or cancelKey(k)
              phase = "menu"
    if phase == "item"
      if confirmKey(k)
        usePotion()
      else
        if d == "right" or cancelKey(k)
          phase = "menu"
    if phase == "target"
      if d == "up" or d == "down"
        retarget()
      else
        if confirmKey(k)
          addSlot(cmd, target)
        else
          if cancelKey(k)
            phase = "menu"
    if phase == "won" and confirmKey(k)
      leaveBattle()
    if phase == "lost" and confirmKey(k)
      wipeOut()

  action onKeyUp(k: string)
    if keyDir(k) == held
      held = ""

  view
    main testId="root" key=onKey keyup=onKeyUp width="100%" height="100%" background-color="#000000"
      canvas surface=ppu((inBattle ? "battle" : "field"), camX, camY,
        (inBattle ? battleSprites.join(";") : fieldSprites.join(";")),
        (inBattle ? battleWindows : fieldWindows), (inBattle ? enemySpec : ""), fade)
        width="100%" height="100%" testId="screen"
      if inBattle
        text phase testId="phase" position="absolute" left=-9999 top=0
