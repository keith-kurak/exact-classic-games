test "Rook's Item menu: a Potion heals the party and takes both segments"
  type "root" key "ArrowRight" for 5300
  clock +1000
  clock +3000
  expect state phase == "menu"
  expect state potions == 3
  type "root" key "ArrowUp"
  type "root" key " "
  expect state phase == "item"
  type "root" key "Escape"
  expect state phase == "menu"
  type "root" key " "
  type "root" key " "
  expect state phase == "act"
  expect state queue.0 == "Potion"
  expect state queue.length == 1
  clock +350
  expect state potions == 2

