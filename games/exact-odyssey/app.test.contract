test "a Revive needs a fallen ally; a stance shift flashes its banner"
  type "root" key "ArrowRight" for 5300
  clock +1100
  type "root" key "ArrowUp"
  type "root" key " "
  type "root" key "ArrowDown"
  expect state itemCursor == 1
  type "root" key " "
  expect state committed == false
  expect state revives == 1
  type "root" key "Escape"
  type "root" key "ArrowLeft"
  type "root" key "ArrowDown"
  type "root" key " "
  expect state shiftT == 26
  clock +1540
  expect state shiftT == 0

test "a Revive brings a fallen ally back at half HP"
  type "root" key "ArrowRight" for 5300
  clock +1100
  type "root" key "ArrowLeft"
  type "root" key "ArrowDown"
  type "root" key " "
  clock +14300
  expect state hp.2 == 0
  type "root" key "ArrowUp"
  type "root" key " "
  type "root" key "ArrowDown"
  type "root" key " "
  expect state plan.0 == "Revive"
  clock +1650
  expect state hp.2 == 45
  expect state revives == 0

test "Mend casts Raise by itself when an ally has fallen, then Cure"
  type "root" key "ArrowRight" for 5300
  clock +1100
  type "root" key "ArrowLeft"
  type "root" key "ArrowDown"
  type "root" key " "
  clock +14300
  expect state hp.2 == 0
  type "root" key "ArrowLeft"
  type "root" key "ArrowDown"
  type "root" key "ArrowDown"
  type "root" key " "
  type "root" key "ArrowUp"
  type "root" key " "
  type "root" key " "
  expect state plan.0 == "Potion"
  clock +4950
  expect state queue.0 == "Raise"
  clock +330
  expect state hp.2 == 62

test "a stance shift mid-attack cancels the party's commands"
  type "root" key "ArrowRight" for 5300
  clock +1100
  type "root" key " "
  type "root" key " "
  expect state committed == true
  clock +1980
  expect state play == "act"
  expect state actor == 0
  type "root" key "ArrowLeft"
  expect state ui == "stance"
  type "root" key "ArrowDown"
  type "root" key " "
  expect state stance == 1
  expect state play == ""
  expect state atb.0 == 0
  expect state plan.length == 0
