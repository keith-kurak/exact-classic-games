test "Rook's Item menu: a Potion heals the party and uses his turn"
  type "root" key "ArrowRight" for 5300
  clock +1000
  clock +3000
  expect state phase == "menu"
  expect state potions == 3
  type "root" key "ArrowDown"
  type "root" key "ArrowDown"
  type "root" key " "
  expect state phase == "item"
  type "root" key "Escape"
  expect state phase == "menu"
  type "root" key " "
  type "root" key " "
  expect state phase == "act"
  expect state cmd == "Potion"
  clock +450
  expect state potions == 2
