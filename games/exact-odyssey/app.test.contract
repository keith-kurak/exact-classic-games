test "the game starts on the field in Reedholm"
  expect tree has "screen"
  expect state scene == "field"
  expect state tx == 11
  expect state ty == 7

test "walking one tile, and talking to the elder"
  type "root" key "ArrowUp" for 250
  clock +200
  expect state ty == 6
  type "root" key "ArrowUp" for 250
  clock +200
  type "root" key "ArrowRight" for 250
  clock +200
  expect state tx == 12
  expect state ty == 5
  expect state dir == "right"
  type "root" key " "
  expect state talkTo == 0
  type "root" key "ArrowLeft" for 250
  expect state tx == 12
  type "root" key " "
  expect state talkTo == -1

test "trees and water block the way"
  type "root" key "ArrowDown" for 4000
  clock +300
  expect state ty == 18
  expect state moving == false

test "the battle runs in real time: allies act while Thunda's menu is open"
  type "root" key "ArrowRight" for 5300
  clock +1100
  expect state scene == "battle"
  expect state phase == "fight"
  expect state ui == "menu"
  clock +3300
  expect state lastAuto == "Tooth"
  expect state ui == "menu"
  expect state committed == false

test "one ability fills a slot; a second and its target commit both; Thunda acts when full"
  type "root" key "ArrowRight" for 5300
  clock +1100
  type "root" key "ArrowDown"
  type "root" key " "
  expect state plan.0 == "Fire"
  expect state ui == "menu"
  type "root" key "Escape"
  expect state plan.length == 0
  type "root" key " "
  type "root" key "ArrowDown"
  type "root" key " "
  expect state ui == "target"
  expect state plan.1 == "Ice"
  type "root" key " "
  expect state committed == true
  expect state ui == "menu"
  clock +4400
  expect state committed == false
  expect state plan.length == 0

test "Right commits a single queued ability early, and it leaves the bar when done"
  type "root" key "ArrowRight" for 5300
  clock +1100
  type "root" key "ArrowDown"
  type "root" key " "
  expect state plan.length == 1
  type "root" key "ArrowRight"
  expect state ui == "target"
  type "root" key " "
  expect state committed == true
  expect state plan.length == 1
  clock +3300
  expect state rookTurns == 1
  expect state committed == false

test "Auto fills both slots by role, then the chooser asks the target"
  type "root" key "ArrowRight" for 5300
  clock +1100
  type "root" key " "
  expect state ui == "target"
  expect state plan.0 == "Fire"
  expect state plan.1 == "Ice"
  type "root" key " "
  expect state committed == true

test "Enter before the bar fills runs only the commands with filled segments"
  type "root" key "ArrowRight" for 5300
  clock +1100
  type "root" key " "
  type "root" key " "
  expect state committed == true
  type "root" key "Enter"
  expect state rush == true
  clock +330
  expect state rookTurns == 1
  expect state queue.length == 1
  expect state committed == false

test "Left opens the stances, free and at any time"
  type "root" key "ArrowRight" for 5300
  clock +1100
  type "root" key "ArrowLeft"
  expect state ui == "stance"
  type "root" key "ArrowDown"
  type "root" key " "
  expect state stance == 1
  expect state ui == "menu"

test "a Potion takes Thunda's turn and heals the party"
  type "root" key "ArrowRight" for 5300
  clock +1100
  type "root" key "ArrowUp"
  type "root" key " "
  expect state ui == "item"
  type "root" key " "
  expect state committed == true
  expect state plan.0 == "Potion"
  clock +4400
  expect state potions == 2

