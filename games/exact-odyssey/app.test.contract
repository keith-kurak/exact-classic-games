test "the game starts on the field in Reedholm"
  expect tree has "screen"
  expect state scene == "field"
  expect state tx == 11
  expect state ty == 7

test "walking one tile, and talking to the elder"
  type "root" key "ArrowUp" for 250
  clock +200
  expect state ty == 6
  type "root" key "ArrowUp" for 250
  clock +200
  type "root" key "ArrowRight" for 250
  clock +200
  expect state tx == 12
  expect state ty == 5
  expect state dir == "right"
  type "root" key " "
  expect state talkTo == 0
  type "root" key "ArrowLeft" for 250
  expect state tx == 12
  type "root" key " "
  expect state talkTo == -1

test "trees and water block the way"
  type "root" key "ArrowDown" for 4000
  clock +300
  expect state ty == 18
  expect state moving == false

test "Rook fills two segments: Auto plans both and waits for a confirm"
  type "root" key "ArrowRight" for 5300
  clock +1000
  expect state scene == "battle"
  expect state phase == "wait"
  clock +3000
  expect state phase == "menu"
  expect state actor == 0
  type "root" key "ArrowLeft"
  expect state phase == "stance"
  type "root" key "ArrowDown"
  type "root" key " "
  expect state stance == 1
  type "root" key "ArrowLeft"
  type "root" key "ArrowUp"
  type "root" key " "
  expect state stance == 0
  type "root" key " "
  expect state phase == "confirm"
  expect state plan.0 == "Fire"
  expect state plan.1 == "Ice"
  type "root" key " "
  expect state phase == "act"
  expect state queue.1 == "Ice"
  expect state msg == "Fire"
  clock +350
  expect state step == 1
  clock +450
  expect state qi == 1
  expect state msg == "Ice"

test "choosing abilities one at a time fills the segments, and Escape takes one back"
  type "root" key "ArrowRight" for 5300
  clock +1000
  clock +3000
  expect state phase == "menu"
  type "root" key "ArrowDown"
  type "root" key " "
  expect state phase == "target"
  type "root" key " "
  expect state phase == "menu"
  expect state plan.0 == "Fire"
  type "root" key "Escape"
  expect state plan.length == 0
  type "root" key " "
  type "root" key " "
  type "root" key "ArrowDown"
  type "root" key " "
  type "root" key " "
  expect state phase == "act"
  expect state queue.0 == "Fire"
  expect state queue.1 == "Ice"

test "Ivy and Kai act on their own"
  type "root" key "ArrowRight" for 5300
  clock +1000
  clock +3000
  type "root" key " "
  type "root" key " "
  clock +6000
  expect state lastAuto == "Ivy"

