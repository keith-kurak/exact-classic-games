// The course: one stage down a half-pipe, in three stretches. The first two
// end at checkpoints that want a running total of beetles; the last ends at
// a giant gem, yours only with enough beetles.
//
// World units: distance along the pipe from the start; angles round the
// pipe from its floor (radians, negative to the left). Above the rims (±π/2)
// the pipe goes on as an open frame, so you can run all the way round.
// Things sit in slots every 5 units, three lanes to a slot; a slot's lanes
// follow one of eight patterns, eight slots at a time.

fn gate(k: number): number = 360 * (k + 1)
fn gateCount(): number = 3
fn goal(k: number): number = nth([40, 80, 120], k)
fn stageEnd(): number = gate(2)
// The last goal is the gem's: it floats in the pipe at the stage's end. The
// run stops this far short of it, and the ending lasts this long (ticks).
fn gemDist(): number = stageEnd()
fn gemStop(): number = 7
fn endLength(): number = 75
// How fast you run in each stretch, a tick (30 a second).
fn speedFor(seg: number): number = nth([0.55, 0.62, 0.7], seg)
// The armadillo runs this far ahead of the camera.
fn ahead(): number = 7

// ── Things ──
fn slotDist(s: number): number = 30 + s * 5
fn thingDist(i: number): number = slotDist(floor(i / 3))
fn nearGate(d: number): bool = range(3).filter(k => max(d - gate(k), gate(k) - d) <= 15).length > 0 or d >= stageEnd()
fn patternOf(s: number): number = nth([0, 1, 2, 5, 6, 3, 1, 2, 0, 4, 8, 1, 3, 6, 5, 7, 1, 0, 4, 7, 8, 3, 5, 6, 8, 7, 1, 0], floor(s / 8))
// 0 none, 1 a beetle, 2 a thorn ball.
fn kindAt(s: number, lane: number): number = (nearGate(slotDist(s)) ? 0 : lanePattern(patternOf(s), s % 8, lane))
fn lanePattern(p: number, k: number, lane: number): number =
  (p == 0 ? (lane == 1 and k < 6 ? 1 : 0)
  : (p == 1 ? (k % 2 == 0 ? 1 : 0)
  : (p == 2 ? (lane == 1 ? 1 : 0)
  : (p == 3 ? (lane == 1 ? ((k == 3 or k == 6) ? 2 : 0) : (k >= 2 ? 1 : 0))
  : (p == 4 ? (k == 4 ? (lane < 2 ? 2 : 1) : (k == 6 ? (lane > 0 ? 2 : 1) : (lane == 1 and k < 3 ? 1 : 0)))
  : (p == 5 ? (lane == 0 ? 1 : 0)
  : (p == 6 ? (lane == 2 ? 1 : 0)
  : (p == 8 ? (lane == 1 ? 1 : 0)
  : (k == 2 ? 2 : (k == 5 ? 1 : 0))))))))))
fn kindOf(i: number): number = (i < 0 ? 0 : kindAt(floor(i / 3), i % 3))
// Where round the pipe: the lanes 0.55 apart about a line that weaves
// (pattern 2), rides a wall (5 and 6), or spirals up the right wall, over
// the top and down the left (8).
fn baseAng(s: number): number = (patternOf(s) == 2 ? sin(s * 0.7) * 0.8
  : (patternOf(s) == 5 ? -0.45 : (patternOf(s) == 6 ? 0.45 : (patternOf(s) == 8 ? (s % 8) * 0.8 : 0))))
fn angOf(i: number): number = baseAng(floor(i / 3)) + (i % 3 - 1) * 0.55

// ── The pipe's shape: its curve (sideways) and climb, every 40 units ──
fn curves(): number[] = [0, 0, 0.006, 0.006, 0, -0.007, -0.007, 0, 0, 0.008, 0.008, 0, -0.006, 0, 0.007, 0.007, 0, -0.008, -0.008, 0, 0.008, 0, -0.009, -0.009, 0, 0.007, 0, 0, 0, 0, 0]
fn rises(): number[] = [0, 0, 0, 0, 0.005, -0.005, 0, 0, 0, 0, 0, 0.006, -0.006, 0, 0, 0, 0.006, -0.006, 0, 0, 0, 0.006, -0.006, 0, 0, 0, 0, 0, 0, 0, 0]
fn lerpAt(xs: number[], d: number): number = nth(xs, floor(max(0, d) / 40)) + (nth(xs, floor(max(0, d) / 40) + 1) - nth(xs, floor(max(0, d) / 40))) * ((max(0, d) / 40) % 1)
fn curveAt(d: number): number = lerpAt(curves(), d)
fn riseAt(d: number): number = lerpAt(rises(), d)

// ── Running ──
fn steer(): number = 0.028
fn grip(): number = 0.8
// Let go and you stop turning: this much of the turn is kept a tick.
fn coast(): number = 0.45
// The camera rolls after you round the pipe, this much of the way a tick.
fn follow(): number = 0.16
// How long the ready fanfare plays before the run (ticks).
fn readyTicks(): number = 66
fn jumpUp(): number = 0.34
fn gravity(): number = 0.03
// Close enough round the pipe to touch.
fn reach(): number = 0.32
fn hurtTicks(): number = 40
fn dropped(): number = 10

// ── Helpers ──
fn nth(xs: number[], k: number): number = match xs.at(k) { case some(v) => v, case none => 0 }
fn absv(v: number): number = max(v, -v)
fn tau(): number = 6.283185307179586
// An angle (or a difference of two) brought into −π..π.
fn wrapA(a: number): number = a - tau() * floor((a + tau() / 2) / tau())
fn clamp(v: number, lo: number, hi: number): number = max(lo, min(hi, v))
fn pad(n: number, w: number): string = `${"000000".slice(0, max(0, w - `${floor(n)}`.length))}${floor(n)}`
fn n3(v: number): string = `${round(v * 1000) / 1000}`
