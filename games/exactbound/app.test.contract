test "the battle's music button pauses and plays"
  type "root" key "ArrowUp"
  type "root" key "ArrowUp"
  type "root" key "ArrowUp"
  type "root" key "ArrowRight"
  type "root" key "ArrowRight"
  type "root" key "ArrowRight"
  type "root" key " "
  type "root" key " "
  type "root" key " "
  type "root" key " "
  type "root" key " "
  type "root" key " "
  clock +1000
  clock settle
  expect text "music-toggle" == "Pause music"
  tap "music-toggle"
  clock settle
  expect state musicPaused == true

test "Juniper's Magic menu casts Fire, which costs PP"
  type "root" key "ArrowUp"
  type "root" key "ArrowUp"
  type "root" key "ArrowUp"
  type "root" key "ArrowRight"
  type "root" key "ArrowRight"
  type "root" key "ArrowRight"
  type "root" key " "
  clock +1500
  type "root" key " "
  clock +1500
  type "root" key " "
  clock +1000
  clock +1000
  type "root" key " "
  expect state phase == "menu"
  expect text "actor" == "Rory"
  expect tree missing "cmd-magic"
  type "root" key " "
  type "root" key " "
  expect text "actor" == "Juniper"
  expect tree has "cmd-magic"
  type "root" key "ArrowDown"
  type "root" key " "
  expect tree has "magic"
  type "root" key "Escape"
  expect tree missing "magic"
  type "root" key " "
  type "root" key " "
  expect state orders.1 == 100
  expect text "actor" == "Teo"
  type "root" key " "
  type "root" key " "
  expect state round == 1
  clock +20000
  expect tree missing "fire-fx"
  expect state ppNow.1 == 35
  expect state phase == "menu"
