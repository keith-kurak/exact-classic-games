test "the field starts at the village gate"
  expect tree has "field"
  expect tree has "player"
  expect tree has "sign-text"
  expect tree has "hint"
  expect tree has "field-music"
  expect tree missing "dialog"
  expect state px == 22
  expect state py == 31

test "a tap walks one tile, and the sign blocks the way"
  type "root" key "ArrowUp"
  type "root" key "ArrowUp"
  type "root" key "ArrowUp"
  expect state py == 28
  expect state hy == 0
  type "root" key "a"
  expect state px == 21
  type "root" key "ArrowLeft"
  type "root" key "ArrowLeft"
  type "root" key "ArrowLeft"
  expect state px == 19
  expect state facing == "left"

test "holding a direction keeps walking, and two keys walk a diagonal"
  type "root" key "ArrowUp" for 500
  expect state px == 22
  expect state py == 27
  expect state hy == 0
  clock +1000
  expect state py == 27
  type "root" key "ArrowRight" down
  expect state px == 23
  expect state py == 27
  type "root" key "ArrowDown" down
  expect state px == 24
  expect state py == 28
  clock +160
  expect state px == 25
  expect state py == 29
  type "root" key "ArrowRight" up
  type "root" key "ArrowDown" up
  clock +1000
  expect state px == 25
  expect state py == 29

test "the sign's words type in, and it starts no battle"
  type "root" key "ArrowUp"
  type "root" key "ArrowUp"
  type "root" key "ArrowUp"
  type "root" key "ArrowLeft"
  type "root" key "ArrowLeft"
  type "root" key "ArrowLeft"
  type "root" key " "
  expect text "speaker" == "Sign"
  expect text "line" == ""
  clock +1000
  expect text "line" == "• CHEERY CHEERY VILLAGE"
  type "root" key "Enter"
  expect state line == 1
  type "root" key "Enter"
  expect text "line" == "• Home of the Order of the Placid Blue. Everyone here is very, very cheery."
  type "root" key "z"
  expect tree missing "dialog"
  clock +1000
  expect tree missing "swirl"
  expect tree missing "battle-screen"

test "a cultist talks, the swirl plays, and Auto Fight wins the battle"
  type "root" key "ArrowUp"
  type "root" key "ArrowUp"
  type "root" key "ArrowUp"
  type "root" key "ArrowRight"
  type "root" key "ArrowRight"
  type "root" key "ArrowRight"
  expect state px == 24
  expect state py == 28
  expect state facing == "right"
  type "root" key " "
  clock +1500
  expect text "line" == "• Welcome, traveler. Have you considered being blue?"
  type "root" key " "
  type "root" key " "
  type "root" key " "
  expect tree has "swirl"
  expect tree missing "battle-screen"
  clock +1000
  expect tree has "battle-screen"
  expect tree has "sky"
  expect tree has "music"
  expect tree missing "field-music"
  expect state msg1 == "• Blue Novice and 1 more block the way!"
  type "root" key " "
  type "root" key " "
  expect tree has "commands"
  expect text "actor" == "Rory"
  type "root" key "ArrowDown"
  type "root" key " "
  expect state auto == true
  clock +400
  expect tree has "auto"
  expect state actor == 1
  clock +24000
  expect state outcome == "won"
  expect tree has "win-dialog"
  expect tree has "win-music"
  expect tree missing "music"
  expect tree missing "battle-dialog"
  expect tree missing "auto"
  type "root" key " "
  expect tree missing "battle-screen"
  expect state beaten.0 == "greeter"
  type "root" key " "
  clock +1500
  expect text "line" == "• Huh. Why am I wearing this shirt? It isn't even my size."
  type "root" key " "
  expect tree missing "dialog"
  clock +1000
  expect tree missing "battle-screen"

