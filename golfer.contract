// The golfer, seen down the line from behind, standing to the left of the
// ball and bent over it: hips pushed back, knees flexed, spine tilted toward
// the ball, head down. The figure is 100 units tall; the ball is at (150, 100),
// drawn by the course shader, not here.

shape Pt
  x: number
  y: number

// The joints that move with the swing.
fn shoulderL(pose: string): Pt = (pose == "follow" ? Pt(x=104, y=27) : (pose == "back" ? Pt(x=117, y=29) : Pt(x=113, y=31)))
fn shoulderR(pose: string): Pt = (pose == "follow" ? Pt(x=124, y=30) : (pose == "back" ? Pt(x=135, y=27) : Pt(x=135, y=36)))
fn head(pose: string): Pt = (pose == "follow" ? Pt(x=116, y=17) : (pose == "back" ? Pt(x=129, y=20) : Pt(x=131, y=24)))
fn hands(pose: string): Pt = (pose == "back" ? Pt(x=144, y=17)
  : (pose == "follow" ? Pt(x=99, y=19) : (pose == "putt" ? Pt(x=136, y=66) : Pt(x=134, y=64))))
fn clubEnd(pose: string): Pt = (pose == "back" ? Pt(x=112, y=4)
  : (pose == "follow" ? Pt(x=136, y=33) : (pose == "putt" ? Pt(x=145, y=99) : Pt(x=147, y=99))))
fn kneeR(pose: string): Pt = (pose == "follow" ? Pt(x=116, y=76) : Pt(x=125, y=75))
fn footR(pose: string): Pt = (pose == "follow" ? Pt(x=119, y=95) : Pt(x=127, y=97))

component Golfer
  props
    pose: string
  view
    svg viewBox="0 0 300 100" width="100%" height="100%" overflow="visible"
      ellipse cx=113 cy=98 rx=22 ry=3.5 fill="#000000" opacity=0.28
      // Legs: thigh and shin, knees flexed forward toward the ball.
      line x1=101 y1=56 x2=103 y2=76 stroke="#7f848d" stroke-width=10 stroke-linecap="round"
      line x1=103 y1=76 x2=98 y2=96 stroke="#7f848d" stroke-width=9 stroke-linecap="round"
      line x1=117 y1=56 x2=kneeR(pose).x y2=kneeR(pose).y stroke="#9196a0" stroke-width=10 stroke-linecap="round"
      line x1=kneeR(pose).x y1=kneeR(pose).y x2=footR(pose).x y2=footR(pose).y stroke="#9196a0" stroke-width=9 stroke-linecap="round"
      ellipse cx=97 cy=98 rx=6.5 ry=2.6 fill="#efefef"
      ellipse cx=(footR(pose).x + 2) cy=(footR(pose).y + 1.5) rx=6.5 ry=2.6 fill="#f7f7f7"
      // The back of the shirt, tilted over the ball, its far side in shade.
      polygon points=`97,57 121,57 ${shoulderR(pose).x},${shoulderR(pose).y} ${shoulderL(pose).x},${shoulderL(pose).y}` fill="#c23a2c"
      polygon points=`113,57 121,57 ${shoulderR(pose).x},${shoulderR(pose).y} ${(shoulderL(pose).x + shoulderR(pose).x) / 2},${(shoulderL(pose).y + shoulderR(pose).y) / 2}` fill="#a52f23"
      line x1=97 y1=57 x2=121 y2=57 stroke="#2b2b2b" stroke-width=2.5
      // Arms hang from the shoulders to the grip.
      line x1=shoulderL(pose).x y1=shoulderL(pose).y x2=hands(pose).x y2=hands(pose).y stroke="#c23a2c" stroke-width=6.5 stroke-linecap="round"
      line x1=shoulderR(pose).x y1=shoulderR(pose).y x2=hands(pose).x y2=hands(pose).y stroke="#a52f23" stroke-width=6.5 stroke-linecap="round"
      // The club: a shaft and a head.
      line x1=hands(pose).x y1=hands(pose).y x2=clubEnd(pose).x y2=clubEnd(pose).y stroke="#1e1e1e" stroke-width=1.8 stroke-linecap="round"
      ellipse cx=clubEnd(pose).x cy=clubEnd(pose).y rx=3.2 ry=1.6 fill="#3a3a3a"
      ellipse cx=hands(pose).x cy=hands(pose).y rx=3.3 ry=3.3 fill="#f4f4f4"
      // Head, seen from behind and above, with the visor's brim toward the ball.
      ellipse cx=head(pose).x cy=head(pose).y rx=6.8 ry=7.5 fill="#5e412a"
      ellipse cx=(head(pose).x + (pose == "follow" ? -2 : 3)) cy=(head(pose).y - 4) rx=7.5 ry=3 fill="#f2f2f2"
