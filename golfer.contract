// The golfer, seen from behind, to the left of the ball. One unit is about
// 1.8 cm of a 1.8 m golfer: the figure is 100 units tall. The ball is at
// (150, 100), drawn by the course shader, not here.

fn handX(pose: string): number = pose == "back" ? 140 : (pose == "follow" ? 98 : (pose == "putt" ? 133 : 136))
fn handY(pose: string): number = pose == "back" ? 16 : (pose == "follow" ? 20 : (pose == "putt" ? 64 : 60))
fn headX(pose: string): number = pose == "follow" ? 116 : 122
fn clubX(pose: string): number = pose == "back" ? 98 : (pose == "follow" ? 140 : (pose == "putt" ? 147 : 150))
fn clubY(pose: string): number = pose == "back" ? 6 : (pose == "follow" ? 34 : 99)

component Golfer
  props
    pose: string
  view
    svg viewBox="0 0 300 100" width="100%" height="100%" overflow="visible"
      ellipse cx=120 cy=99 rx=18 ry=3 fill="#000000" opacity=0.3
      // Legs and shoes.
      line x1=111 y1=56 x2=(pose == "follow" ? 112 : 106) y2=96 stroke="#8a8f99" stroke-width=9 stroke-linecap="round"
      line x1=127 y1=56 x2=(pose == "follow" ? 124 : 131) y2=(pose == "follow" ? 92 : 96) stroke="#7c818b" stroke-width=9 stroke-linecap="round"
      ellipse cx=(pose == "follow" ? 113 : 105) cy=98 rx=6 ry=2.5 fill="#f2f2f2"
      ellipse cx=(pose == "follow" ? 126 : 132) cy=(pose == "follow" ? 95 : 98) rx=6 ry=2.5 fill="#f2f2f2"
      // Shirt: shoulders lean over the ball at address, turn after impact.
      polygon points=(pose == "follow" ? "106,60 131,60 128,28 100,30" : "106,60 131,60 138,30 108,28") fill="#c23a2c"
      line x1=(pose == "follow" ? 104 : 110) y1=31 x2=handX(pose) y2=handY(pose) stroke="#c23a2c" stroke-width=7 stroke-linecap="round"
      line x1=(pose == "follow" ? 126 : 135) y1=32 x2=handX(pose) y2=handY(pose) stroke="#b13427" stroke-width=7 stroke-linecap="round"
      ellipse cx=handX(pose) cy=handY(pose) rx=3.5 ry=3.5 fill="#f4f4f4"
      // The club.
      line x1=handX(pose) y1=handY(pose) x2=clubX(pose) y2=clubY(pose) stroke="#222222" stroke-width=2 stroke-linecap="round"
      // Head and visor.
      ellipse cx=headX(pose) cy=20 rx=7.5 ry=8.5 fill="#6b4a2f"
      ellipse cx=headX(pose) cy=14 rx=8.5 ry=3.5 fill="#f2f2f2"
